# ====================================================================
# TRIONYX PRODUCTION ENVIRONMENT VARIABLES
# ====================================================================

# --------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (SUPABASE POSTGRESQL)
# --------------------------------------------------------------------
# Get this from Supabase Dashboard -> Project Settings -> Database -> Connection String (URI / Session / Transaction Pooler)
# Example (Transaction Pooler - Port 6543):
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"

# Alternatively, Direct Connection (Port 5432):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# For local offline development (Optional):
# DATABASE_URL="file:./trionyx.db"

# --------------------------------------------------------------------
# 2. SUPABASE STORAGE (PRODUCT MEDIA & DOCUMENTS)
# --------------------------------------------------------------------
# Get these from Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"

# Service Role Key (kept secret, used server-side in API routes for uploads)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Public Storage Bucket Name (create this bucket in Supabase Storage with "Public" enabled)
SUPABASE_STORAGE_BUCKET="trionyx-media"

# --------------------------------------------------------------------
# 3. APPLICATION URLS & DOMAINS
# --------------------------------------------------------------------
# Public Website (Vercel Project 1: apps/web)
NEXT_PUBLIC_APP_URL="https://trionyx.in"

# Internal Operations Portal (Vercel Project 2: apps/portal)
NEXT_PUBLIC_PORTAL_URL="https://ops.trionyx.in"

# Dealer Portal (Vercel Project 3: apps/dealer)
NEXT_PUBLIC_DEALER_PORTAL_URL="https://dealers.trionyx.in"

# --------------------------------------------------------------------
# 4. RUNTIME SETTINGS
# --------------------------------------------------------------------
NODE_ENV="production"

# Optional: Inventory dealer threshold (defaults to 10 if not set)
DEALER_AVAILABILITY_THRESHOLD="10"
