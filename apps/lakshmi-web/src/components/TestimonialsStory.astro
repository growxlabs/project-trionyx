---
import Container from './Container.astro';
import { testimonials, type Testimonial } from '../data/testimonials';

interface Props {
  items?: readonly Testimonial[];
}

const { items = testimonials } = Astro.props;
---

<section
  id="reviews-section"
  class="telemetry-stack-section"
  aria-labelledby="reviews-title"
  data-telemetry-section
>
  <Container>
    <!-- Section Header & Telemetry Controls -->
    <div class="telemetry-header-bar">
      <div class="telemetry-header-left">
        <span class="telemetry-eyebrow">
          <span class="status-pulse" aria-hidden="true"></span>
          FEEDBACK // FIELD TELEMETRY
        </span>
        <h2 id="reviews-title" class="telemetry-title">What partners & drivers say</h2>
      </div>

      <div class="telemetry-controls" aria-label="Testimonial navigation">
        <div class="telemetry-counter" aria-live="polite">
          <span class="counter-label">INDEX</span>
          <span class="counter-value">
            <span data-active-index>01</span> / <span class="counter-total">0{items.length}</span>
          </span>
        </div>
        <div class="stepper-buttons">
          <button
            type="button"
            class="telemetry-btn"
            data-prev-btn
            aria-label="Previous testimonial"
            title="Previous (Arrow Up)"
          >
            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M8 12V4M4 8l4-4 4 4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <button
            type="button"
            class="telemetry-btn"
            data-next-btn
            aria-label="Next testimonial"
            title="Next (Arrow Down)"
          >
            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M8 4v8M4 8l4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Main Dual Telemetry Stage -->
    <div class="telemetry-layout">
      <!-- Left Rail: Telemetry Station Selector (Desktop) -->
      <nav class="telemetry-rail" aria-label="Testimonial station index">
        <div class="rail-track-line" aria-hidden="true">
          <div class="rail-progress-thumb" data-rail-thumb></div>
        </div>
        <ul class="rail-list">
          {items.map((item, index) => (
            <li>
              <button
                type="button"
                class={`rail-node ${index === 0 ? 'is-active' : ''}`}
                data-rail-node
                data-target-index={index}
                aria-label={`Jump to review ${index + 1}: ${item.name}`}
              >
                <span class="node-num">0{index + 1}</span>
                <div class="node-meta">
                  <span class="node-category">{item.categoryLabel || 'VERIFIED FIELD REPORT'}</span>
                  <span class="node-name">{item.name}</span>
                </div>
              </button>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Right Main: Precision HUD Telemetry Frame -->
      <div class="telemetry-dock" data-telemetry-dock>
        {items.map((item, index) => {
          const hasImage = Boolean(item.image);
          const isActive = index === 0;

          return (
            <article
              class={`telemetry-card ${isActive ? 'is-active' : ''} ${hasImage ? 'has-media' : 'text-only'}`}
              data-card-index={index}
              aria-hidden={isActive ? 'false' : 'true'}
            >
              <!-- Card Tactical HUD Header -->
              <div class="card-hud-bar">
                <div class="hud-tag">
                  <span class="hud-status-dot" aria-hidden="true"></span>
                  <span class="hud-tag-text">{item.categoryLabel || 'VERIFIED FIELD REPORT'}</span>
                </div>
                <div class="hud-id">
                  <span>LOG #{item.id.replace('review-', '0')}</span>
                  {item.location && <span class="hud-location">· {item.location}</span>}
                </div>
              </div>

              <!-- Card Body Content -->
              <div class="card-body-grid">
                {hasImage && (
                  <div class="card-media-panel">
                    <img
                      src={item.image}
                      alt={item.name}
                      class="card-media-img"
                      loading={index === 0 ? 'eager' : 'lazy'}
                    />
                    <div class="media-overlay-gradient" aria-hidden="true"></div>
                    <div class="media-hud-bracket top-left" aria-hidden="true"></div>
                    <div class="media-hud-bracket bottom-right" aria-hidden="true"></div>
                  </div>
                )}

                <div class="card-content-panel">
                  <div class="quote-wrapper">
                    <span class="quote-mark" aria-hidden="true">“</span>
                    <blockquote class="card-quote">
                      {item.quote}
                    </blockquote>
                  </div>

                  <div class="card-footer-author">
                    <div class="author-avatar-badge" aria-hidden="true">
                      {item.name.split(' ').map(n => n[0]).join('')}
                    </div>
                    <div class="author-details">
                      <p class="author-name">{item.name}</p>
                      <p class="author-company">
                        {item.company}
                        {item.type && (
                          <span class="author-type-badge">
                            {item.type === 'dealer' ? 'TRADE PARTNER' : 'VERIFIED UPGRADE'}
                          </span>
                        )}
                      </p>
                    </div>
                  </div>
                </div>
              </div>

              <!-- Precision Corner Accents -->
              <div class="corner-tick corner-tl" aria-hidden="true"></div>
              <div class="corner-tick corner-tr" aria-hidden="true"></div>
              <div class="corner-tick corner-bl" aria-hidden="true"></div>
              <div class="corner-tick corner-br" aria-hidden="true"></div>
            </article>
          );
        })}
      </div>
    </div>
  </Container>
</section>

<style>
  /* ------------------------------------------------------------------ */
  /* SECTION FOUNDATION & ENVIRONMENT                                   */
  /* ------------------------------------------------------------------ */
  .telemetry-stack-section {
    position: relative;
    background: #0B0D10;
    color: #F7F7F5;
    padding-block: clamp(4rem, 8vh, 6.5rem);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  /* Subtle ambient beam glow in background */
  .telemetry-stack-section::before {
    content: '';
    position: absolute;
    top: 25%;
    right: 15%;
    width: 600px;
    height: 400px;
    background: radial-gradient(circle, rgba(233, 93, 44, 0.06) 0%, transparent 70%);
    pointer-events: none;
    filter: blur(40px);
  }

  /* ------------------------------------------------------------------ */
  /* TELEMETRY HEADER & CONTROLS                                       */
  /* ------------------------------------------------------------------ */
  .telemetry-header-bar {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(2.5rem, 5vh, 3.5rem);
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .telemetry-header-left {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .telemetry-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: #E95D2C;
    text-transform: uppercase;
  }

  .status-pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #E95D2C;
    box-shadow: 0 0 8px rgba(233, 93, 44, 0.8);
    animation: statusPulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @keyframes statusPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .telemetry-title {
    font-size: clamp(1.75rem, 2.5vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.15;
    margin: 0;
    color: #F7F7F5;
  }

  .telemetry-controls {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .telemetry-counter {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.875rem;
  }

  .counter-label {
    color: #71767C;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
  }

  .counter-value {
    color: #F7F7F5;
    font-weight: 700;
  }

  .counter-value [data-active-index] {
    color: #E95D2C;
  }

  .counter-total {
    color: #71767C;
    font-weight: 400;
  }

  .stepper-buttons {
    display: flex;
    gap: 0.375rem;
  }

  .telemetry-btn {
    width: 38px;
    height: 38px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: #14171B;
    color: #F7F7F5;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 150ms ease, border-color 150ms ease, transform 100ms ease;
  }

  .telemetry-btn:hover {
    background: #1C2127;
    border-color: #E95D2C;
    color: #FFFFFF;
  }

  .telemetry-btn:active {
    transform: scale(0.95);
  }

  /* ------------------------------------------------------------------ */
  /* TELEMETRY LAYOUT (RAIL + DOCK)                                     */
  /* ------------------------------------------------------------------ */
  .telemetry-layout {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  /* Left Rail */
  .telemetry-rail {
    position: relative;
    padding-left: 1.5rem;
  }

  .rail-track-line {
    position: absolute;
    left: 0;
    top: 10px;
    bottom: 10px;
    width: 2px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 2px;
  }

  .rail-progress-thumb {
    position: absolute;
    top: 0;
    left: -1px;
    width: 4px;
    height: 20%;
    background: #E95D2C;
    border-radius: 4px;
    box-shadow: 0 0 10px rgba(233, 93, 44, 0.6);
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1), height 300ms ease;
  }

  .rail-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .rail-node {
    width: 100%;
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    padding: 0.75rem 1rem;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    color: #8C939A;
    text-align: left;
    cursor: pointer;
    transition: background-color 180ms ease, color 180ms ease, border-color 180ms ease;
  }

  .rail-node:hover {
    background: rgba(255, 255, 255, 0.03);
    color: #F7F7F5;
  }

  .rail-node.is-active {
    background: rgba(233, 93, 44, 0.08);
    border-color: rgba(233, 93, 44, 0.3);
    color: #F7F7F5;
  }

  .node-num {
    font-family: var(--font-mono, monospace);
    font-size: 0.8125rem;
    font-weight: 700;
    color: #71767C;
    margin-top: 2px;
  }

  .rail-node.is-active .node-num {
    color: #E95D2C;
  }

  .node-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .node-category {
    font-family: var(--font-mono, monospace);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #71767C;
  }

  .rail-node.is-active .node-category {
    color: rgba(233, 93, 44, 0.9);
  }

  .node-name {
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.25;
  }

  /* ------------------------------------------------------------------ */
  /* TELEMETRY DOCK & CARDS (VERTICAL STACK)                            */
  /* ------------------------------------------------------------------ */
  .telemetry-dock {
    position: relative;
    min-height: 440px;
  }

  .telemetry-card {
    position: absolute;
    inset: 0;
    background: #121519;
    background: linear-gradient(175deg, rgba(255, 255, 255, 0.02) 0%, rgba(18, 21, 25, 0.98) 100%);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 12px;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5), 0 1px 3px rgba(0, 0, 0, 0.4);
    opacity: 0;
    transform: translateY(28px) scale(0.98);
    pointer-events: none;
    transition: opacity 320ms cubic-bezier(0.16, 1, 0.3, 1),
                transform 320ms cubic-bezier(0.16, 1, 0.3, 1),
                border-color 200ms ease;
  }

  .telemetry-card.is-active {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
    border-color: rgba(233, 93, 44, 0.4);
    z-index: 5;
  }

  /* Exiting card upwards */
  .telemetry-card.is-exiting-up {
    opacity: 0;
    transform: translateY(-28px) scale(0.98);
    z-index: 2;
  }

  /* ------------------------------------------------------------------ */
  /* CARD HUD TOP BAR                                                   */
  /* ------------------------------------------------------------------ */
  .card-hud-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    font-family: var(--font-mono, monospace);
  }

  .hud-tag {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: #E95D2C;
    text-transform: uppercase;
  }

  .hud-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #18C88A;
    box-shadow: 0 0 6px rgba(24, 200, 138, 0.6);
  }

  .hud-id {
    font-size: 0.6875rem;
    color: #71767C;
    letter-spacing: 0.08em;
  }

  .hud-location {
    color: #A7ADB2;
  }

  /* ------------------------------------------------------------------ */
  /* CARD BODY & MEDIA                                                 */
  /* ------------------------------------------------------------------ */
  .card-body-grid {
    display: grid;
    gap: 2rem;
    flex: 1;
    align-items: center;
  }

  .has-media .card-body-grid {
    grid-template-columns: 42% 58%;
  }

  .text-only .card-body-grid {
    grid-template-columns: 1fr;
    max-width: 50rem;
  }

  .card-media-panel {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 250px;
    border-radius: 10px;
    overflow: hidden;
    background: #090B0D;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .card-media-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    filter: brightness(0.95) contrast(1.05);
  }

  .media-overlay-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, transparent 50%, rgba(11, 13, 16, 0.8) 100%);
    pointer-events: none;
  }

  /* HUD Micro-Brackets */
  .media-hud-bracket {
    position: absolute;
    width: 12px;
    height: 12px;
    border-color: #E95D2C;
    border-style: solid;
    opacity: 0.7;
    pointer-events: none;
  }

  .media-hud-bracket.top-left {
    top: 8px;
    left: 8px;
    border-width: 2px 0 0 2px;
  }

  .media-hud-bracket.bottom-right {
    bottom: 8px;
    right: 8px;
    border-width: 0 2px 2px 0;
  }

  .card-content-panel {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
    gap: 1.75rem;
  }

  .quote-wrapper {
    position: relative;
  }

  .quote-mark {
    position: absolute;
    top: -1.75rem;
    left: -0.75rem;
    font-size: 3.5rem;
    line-height: 1;
    color: rgba(233, 93, 44, 0.2);
    font-family: var(--font-mono, monospace);
    pointer-events: none;
    user-select: none;
  }

  .card-quote {
    margin: 0;
    font-size: clamp(1.2rem, 1.8vw, 1.6rem);
    line-height: 1.42;
    font-weight: 500;
    letter-spacing: -0.015em;
    color: #F7F7F5;
  }

  /* Author block */
  .card-footer-author {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .author-avatar-badge {
    width: 42px;
    height: 42px;
    border-radius: 8px;
    background: rgba(233, 93, 44, 0.12);
    border: 1px solid rgba(233, 93, 44, 0.3);
    color: #E95D2C;
    font-family: var(--font-mono, monospace);
    font-weight: 700;
    font-size: 0.875rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .author-details {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .author-name {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    color: #FFFFFF;
  }

  .author-company {
    margin: 0;
    font-size: 0.8125rem;
    color: #8C939A;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .author-type-badge {
    display: inline-block;
    padding: 1px 6px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    font-family: var(--font-mono, monospace);
    font-size: 0.625rem;
    font-weight: 600;
    color: #CCD2D8;
    letter-spacing: 0.06em;
  }

  /* ------------------------------------------------------------------ */
  /* PRECISION CORNER TICKS                                             */
  /* ------------------------------------------------------------------ */
  .corner-tick {
    position: absolute;
    width: 8px;
    height: 8px;
    border-color: rgba(255, 255, 255, 0.2);
    border-style: solid;
    pointer-events: none;
    transition: border-color 200ms ease;
  }

  .telemetry-card.is-active .corner-tick {
    border-color: rgba(233, 93, 44, 0.6);
  }

  .corner-tl { top: -1px; left: -1px; border-width: 2px 0 0 2px; border-top-left-radius: 12px; }
  .corner-tr { top: -1px; right: -1px; border-width: 2px 2px 0 0; border-top-right-radius: 12px; }
  .corner-bl { bottom: -1px; left: -1px; border-width: 0 0 2px 2px; border-bottom-left-radius: 12px; }
  .corner-br { bottom: -1px; right: -1px; border-width: 0 2px 2px 0; border-bottom-right-radius: 12px; }

  /* ------------------------------------------------------------------ */
  /* RESPONSIVE BREAKPOINTS                                             */
  /* ------------------------------------------------------------------ */
  @media (max-width: 900px) {
    .telemetry-layout {
      grid-template-columns: 1fr;
    }

    .telemetry-rail {
      display: none;
    }

    .telemetry-dock {
      min-height: 480px;
    }

    .has-media .card-body-grid {
      grid-template-columns: 1fr;
    }

    .card-media-panel {
      height: 200px;
      min-height: 200px;
    }
  }

  @media (max-width: 600px) {
    .telemetry-header-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .telemetry-controls {
      width: 100%;
      justify-content: space-between;
    }

    .telemetry-dock {
      min-height: 520px;
    }

    .telemetry-card {
      padding: 1.25rem;
    }

    .card-quote {
      font-size: 1.125rem;
    }
  }
</style>

<script>
  function initTelemetryStack() {
    const section = document.querySelector<HTMLElement>('[data-telemetry-section]');
    if (!section) return;

    const cards = Array.from(section.querySelectorAll<HTMLElement>('[data-card-index]'));
    const railNodes = Array.from(section.querySelectorAll<HTMLButtonElement>('[data-rail-node]'));
    const railThumb = section.querySelector<HTMLElement>('[data-rail-thumb]');
    const activeIndexEl = section.querySelector<HTMLElement>('[data-active-index]');
    const prevBtn = section.querySelector<HTMLButtonElement>('[data-prev-btn]');
    const nextBtn = section.querySelector<HTMLButtonElement>('[data-next-btn]');

    if (cards.length === 0) return;

    let currentIndex = 0;
    const total = cards.length;

    function goToIndex(targetIndex: number, direction: 'up' | 'down' = 'down') {
      if (targetIndex < 0) targetIndex = total - 1;
      if (targetIndex >= total) targetIndex = 0;
      if (targetIndex === currentIndex) return;

      const oldCard = cards[currentIndex];
      const newCard = cards[targetIndex];

      // Mark old card exiting
      if (oldCard) {
        oldCard.classList.remove('is-active');
        oldCard.setAttribute('aria-hidden', 'true');
        oldCard.classList.add(direction === 'down' ? 'is-exiting-up' : '');
        setTimeout(() => {
          oldCard.classList.remove('is-exiting-up');
        }, 350);
      }

      // Activate new card
      if (newCard) {
        newCard.classList.add('is-active');
        newCard.setAttribute('aria-hidden', 'false');
      }

      // Update counter
      if (activeIndexEl) {
        activeIndexEl.textContent = `0${targetIndex + 1}`;
      }

      // Update rail active state
      railNodes.forEach((node, idx) => {
        if (idx === targetIndex) {
          node.classList.add('is-active');
        } else {
          node.classList.remove('is-active');
        }
      });

      // Update rail progress thumb
      if (railThumb && railNodes.length > 0) {
        
        railThumb.style.transform = `translateY(${(targetIndex * 48)}px)`;
      }

      currentIndex = targetIndex;
    }

    // Button event listeners
    prevBtn?.addEventListener('click', () => goToIndex(currentIndex - 1, 'up'));
    nextBtn?.addEventListener('click', () => goToIndex(currentIndex + 1, 'down'));

    // Rail nodes event listeners
    railNodes.forEach((node) => {
      node.addEventListener('click', () => {
        const target = Number(node.getAttribute('data-target-index'));
        if (!isNaN(target)) {
          goToIndex(target, target > currentIndex ? 'down' : 'up');
        }
      });
    });

    // Keyboard navigation (Arrow Up / Down) when section has focus
    section.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowUp') {
        e.preventDefault();
        goToIndex(currentIndex - 1, 'up');
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        goToIndex(currentIndex + 1, 'down');
      }
    });

    // Optional subtle wheel support when hovering over the dock
    let isWheeling = false;
    section.addEventListener('wheel', (e) => {
      if (Math.abs(e.deltaY) < 30 || isWheeling) return;
      if (e.deltaY > 0 && currentIndex < total - 1) {
        isWheeling = true;
        goToIndex(currentIndex + 1, 'down');
        setTimeout(() => { isWheeling = false; }, 600);
      } else if (e.deltaY < 0 && currentIndex > 0) {
        isWheeling = true;
        goToIndex(currentIndex - 1, 'up');
        setTimeout(() => { isWheeling = false; }, 600);
      }
    }, { passive: true });
  }

  // Initialize on DOM load and view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTelemetryStack);
  } else {
    initTelemetryStack();
  }
  document.addEventListener('astro:page-load', initTelemetryStack);
</script>
