---
interface Props {
  name: string;
  href: string;
  brand?: string | null;
  category?: string | null;
  specification?: string | null;
  image?: { src: string; alt: string } | null;
}

const { name, href, brand, category, specification, image } = Astro.props;
---

<article class="product-card">
  <a href={href} class="product-card-link-wrap" aria-label={`View ${name}`}>
    <div class="product-card-image-box">
      {image ? (
        <img
          class="product-card-image"
          src={image.src}
          alt={image.alt}
          loading="lazy"
        />
      ) : (
        <div class="product-card-placeholder">
          <span>Lighting Module</span>
        </div>
      )}
    </div>
    <div class="product-card-body">
      {brand && <span class="product-card-brand">{brand}</span>}
      <h3 class="product-card-title">{name}</h3>
      <div class="product-card-meta">
        {category && <span class="product-card-category">{category}</span>}
        {specification && <span class="product-card-spec">{specification}</span>}
      </div>
      <div class="product-card-action">
        <span class="action-text">View Product</span>
        <span class="action-arrow" aria-hidden="true">→</span>
      </div>
    </div>
  </a>
</article>

<style>
  .product-card {
    background: var(--color-surface);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color 200ms ease, background-color 200ms ease;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .product-card:hover {
    border-color: rgba(233, 93, 44, 0.45);
    background: #181C20;
  }

  .product-card-link-wrap {
    display: flex;
    flex-direction: column;
    flex: 1;
    text-decoration: none;
    color: inherit;
  }

  .product-card-image-box {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    background: #0E1013;
    overflow: hidden;
    border-bottom: var(--border-width) solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .product-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 300ms ease;
  }

  .product-card:hover .product-card-image {
    transform: scale(1.03);
  }

  .product-card-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    font-size: var(--font-small);
    background: #121417;
  }

  .product-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5);
    flex: 1;
  }

  .product-card-brand {
    font-size: var(--font-label);
    font-weight: var(--weight-strong);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .product-card-title {
    font-size: var(--font-product);
    font-weight: var(--weight-strong);
    color: var(--color-text);
    line-height: 1.3;
  }

  .product-card-meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-top: var(--space-1);
    font-size: var(--font-small);
    color: var(--color-text-muted);
  }

  .product-card-spec {
    color: #CCD2D8;
  }

  .product-card-action {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-4);
    font-size: var(--font-small);
    font-weight: var(--weight-strong);
    color: var(--color-primary);
  }

  .action-arrow {
    transition: transform 200ms ease;
  }

  .product-card:hover .action-arrow {
    transform: translateX(4px);
  }
</style>
