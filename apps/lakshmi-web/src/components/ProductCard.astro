---
interface Props {
  name: string;
  href: string;
  brand?: string | null;
  category?: string | null;
  specification?: string | null;
  image?: { src: string; alt: string } | null;
}

const { name, href, brand, category, specification, image } = Astro.props;
const meta = [brand, category].filter(Boolean).join(' · ');
---

<article class="product-card">
  <a href={href} class="product-link">
    <div class="product-media">
      {image ? (
        <img class="product-image" src={image.src} alt={image.alt} loading="lazy" />
      ) : (
        <span class="product-placeholder">Image coming soon</span>
      )}
    </div>
    <div class="product-body">
      <h3 class="product-title">{name}</h3>
      {meta && <p class="product-meta">{meta}</p>}
      {specification && <p class="product-spec">{specification}</p>}
    </div>
  </a>
</article>

<style>
  .product-card {
    min-width: 0;
    height: 100%;
  }

  .product-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .product-media {
    display: grid;
    place-items: center;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 16px;
    background: var(--color-surface);
  }

  .product-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .product-link:hover .product-image {
    transform: scale(1.04);
  }

  .product-placeholder {
    font-size: var(--font-small);
    color: var(--color-text-faint);
  }

  .product-body {
    padding: 1rem 0.25rem 0;
  }

  .product-title {
    font-size: 1.125rem;
    line-height: 1.3;
    transition: color 200ms ease;
  }

  .product-link:hover .product-title {
    color: var(--color-primary-hover);
  }

  .product-meta {
    margin-top: 0.375rem;
    font-size: var(--font-small);
    color: var(--color-text-muted);
  }

  .product-spec {
    margin-top: 0.25rem;
    font-size: 0.8125rem;
    color: var(--color-text-faint);
  }

  .product-link:focus-visible {
    outline-offset: 6px;
    border-radius: 16px;
  }

  @media (prefers-reduced-motion: reduce) {
    .product-image {
      transition: none;
    }

    .product-link:hover .product-image {
      transform: none;
    }
  }
</style>
