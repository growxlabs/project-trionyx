---
import type { BrandMedia } from '../data/brandMedia';

interface Props {
  name: string;
  href: string;
  description?: string;
  media?: BrandMedia;
}

const { name, href, description, media } = Astro.props;
---

<article class="brand-card">
  <a href={href} class="brand-link">
    <div class="brand-media">
      {media && <img class="brand-image" src={media.image.src} alt={media.image.alt} loading="lazy" />}
      <div class="brand-blur" aria-hidden="true"></div>
      <div class="brand-caption">
        {media ? (
          <img class="brand-logo" src={media.logo.src} alt={name} />
        ) : (
          <span class="brand-name">{name}</span>
        )}
        <span class="brand-arrow" aria-hidden="true">→</span>
      </div>
    </div>
  </a>
  {description && <p class="brand-description">{description}</p>}
</article>

<style>
  .brand-card {
    min-width: 0;
  }

  .brand-link {
    display: block;
    color: var(--color-text);
    text-decoration: none;
  }

  .brand-media {
    position: relative;
    isolation: isolate;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: 16px;
    background: var(--color-surface);
  }

  .brand-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .brand-link:hover .brand-image {
    transform: scale(1.04);
  }

  .brand-blur {
    position: absolute;
    inset: auto 0 0;
    height: 40%;
    backdrop-filter: blur(18px) saturate(1.1);
    -webkit-backdrop-filter: blur(18px) saturate(1.1);
    background: linear-gradient(to top, rgba(14, 13, 11, 0.6), rgba(14, 13, 11, 0));
    -webkit-mask-image: linear-gradient(to top, #000 45%, transparent);
    mask-image: linear-gradient(to top, #000 45%, transparent);
  }

  .brand-caption {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.5rem 1.75rem;
  }

  /* Logos render in one bone tone, matching the home page brand strip. */
  .brand-logo {
    height: 28px;
    width: auto;
    max-width: 60%;
    object-fit: contain;
    object-position: left;
    filter: brightness(0) invert(0.92) sepia(0.12);
  }

  .brand-name {
    font-size: 1.5rem;
  }

  .brand-arrow {
    font-size: 1.125rem;
    opacity: 0.7;
    transition: transform 300ms ease, opacity 300ms ease;
  }

  .brand-link:hover .brand-arrow {
    transform: translateX(4px);
    opacity: 1;
  }

  .brand-description {
    margin-top: 1.25rem;
    max-width: 48ch;
    color: var(--color-text-muted);
  }

  .brand-link:focus-visible {
    outline-offset: 4px;
    border-radius: 16px;
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-image,
    .brand-arrow {
      transition: none;
    }

    .brand-link:hover .brand-image,
    .brand-link:hover .brand-arrow {
      transform: none;
    }
  }
</style>
