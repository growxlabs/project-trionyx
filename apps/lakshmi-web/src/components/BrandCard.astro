---
interface Props {
  name: string;
  href: string;
  description?: string;
  image?: { src: string; alt: string };
}
const { name, href, description, image } = Astro.props;
---
<article class="catalogue-card brand-card">
  <a href={href} class="brand-image-link" tabindex="-1" aria-hidden="true">
    <div class="brand-image-container">
      {image ? (
        <img class="brand-card-image" src={image.src} alt="" loading="lazy" />
      ) : (
        <div class="card-image card-placeholder">Brand image not supplied</div>
      )}
    </div>
  </a>
  <div class="card-body">
    <h3 class="heading-product"><a class="card-link" href={href}>{name}</a></h3>
    {description && <p class="text-small text-muted">{description}</p>}
  </div>
</article>

<style>
  .brand-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: border-color 150ms ease;
  }
  .brand-card:hover {
    border-color: #3b4249;
  }
  .brand-image-link {
    text-decoration: none;
    display: block;
  }
  .brand-image-container {
    width: 100%;
    aspect-ratio: var(--image-ratio, 4 / 3);
    background: #121518;
    border-bottom: var(--border-width) solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(1.75rem, 3.5vw, 2.75rem);
    box-sizing: border-box;
    overflow: hidden;
  }
  .brand-card-image {
    max-width: 85%;
    max-height: 72%;
    width: auto;
    height: auto;
    object-fit: contain;
    transition: transform 180ms ease;
    filter: drop-shadow(0 2px 10px rgba(0, 0, 0, 0.45));
  }
  .brand-card:hover .brand-card-image {
    transform: scale(1.05);
  }
  .card-placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    color: var(--color-text-muted);
    font-size: var(--font-small);
  }
</style>
