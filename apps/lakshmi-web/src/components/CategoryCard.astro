---
import CategoryArtwork from './CategoryArtwork.astro';
import PpfBeforeAfter from './PpfBeforeAfter.astro';

interface Props {
  name: string;
  brand?: string;
  brandSlug?: string;
  href?: string;
  description?: string;
  image?: { src: string; alt: string };
  productCount?: number;
  featured?: boolean;
}

const { name, brand, href = '/products', description, image } = Astro.props;
const isPpf = name === 'Paint Protection Film';
---

<article class="category-card">
  {isPpf ? (
    <div class="category-card-inner">
      <div class="category-visual ppf-visual-wrap">
        {image ? <img src={image.src} alt={image.alt} loading="lazy" width="1536" height="1024" /> : <PpfBeforeAfter />}
        {image && <span class="visual-label">PAINT PROTECTION FILM</span>}
      </div>
      <div class="category-content">
        <div>
          <span class="category-brand">HOGGON</span>
          <a href={href} class="category-title-link"><h3>{name}</h3></a>
          {description && <p>{description}</p>}
        </div>
        <a href={href} class="category-action category-action-link" aria-label={`Explore ${name} category`}>
          <span>Explore category</span>
          <span class="action-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  ) : (
    <a href={href} class="category-card-inner" aria-label={`Explore ${name}`}>
      <div class="category-visual">
        {image ? <img src={image.src} alt={image.alt} loading="lazy" width="1024" height="1024" /> : <CategoryArtwork name={name} />}
        <span class="visual-label">{name === 'LED Lamps' ? 'LIGHTING COLLECTION' : 'MATERIAL COLLECTION'}</span>
      </div>
      <div class="category-content">
        <div>
          {brand && <span class="category-brand">{brand === 'Hoggon' ? 'Hogonn' : brand}</span>}
          <h3>{name}</h3>
          {description && <p>{description}</p>}
        </div>
        <div class="category-action"><span>Explore collection</span><span class="action-arrow" aria-hidden="true">↗</span></div>
      </div>
    </a>
  )}
</article>

<style>
.category-card { height:100%; overflow:hidden; border:1px solid #2b3238; border-radius:10px; background:#14191d; transition:border-color 180ms ease,transform 180ms ease; }
.category-card:hover { border-color:#6d4b3e; transform:translateY(-3px); }
.category-card-inner { display:grid; grid-template-columns:46% 54%; min-height:300px; height:100%; text-decoration:none; color:inherit; }
.category-card-inner:focus-visible { outline:2px solid #ff936a; outline-offset:-3px; }
.category-visual { position:relative; min-width:0; overflow:hidden; background:linear-gradient(145deg,#1e282f,#0b1014 80%); border-right:1px solid #2b3238; }
.category-visual > img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform 350ms ease; }
.category-visual > :global(svg) { position:absolute; inset:0; object-fit:contain; }
.category-card:hover .category-visual > img { transform:scale(1.035); }
.ppf-visual-wrap { background:#0b1014; }
.visual-label { position:absolute; left:16px; bottom:16px; background:#080a0cda; border:1px solid #ffffff1a; color:#c4cdd3; padding:7px 9px; border-radius:3px; font-size:8px; font-weight:600; letter-spacing:.12em; }
.category-content { display:flex; flex-direction:column; justify-content:space-between; gap:24px; padding:28px; min-width:0; }
.category-brand { display:block; margin-bottom:13px; color:#f28b61; font-size:10px; font-weight:600; letter-spacing:.14em; text-transform:uppercase; }
.category-title-link { text-decoration:none; color:inherit; }
.category-title-link:hover h3 { color:#ffffff; }
h3 { margin:0; font-size:clamp(20px,1.6vw,26px); font-weight:600; line-height:1.22; letter-spacing:-.025em; color:#f4f5f6; text-wrap:balance; }
p { margin:14px 0 0; font-size:13px; line-height:1.7; color:#acb6bd; max-width:32ch; }
.category-action { display:flex; align-items:center; justify-content:space-between; gap:12px; border-top:1px solid #2c3339; padding-top:19px; font-size:12px; font-weight:600; color:#e7ebee; }
.category-action-link { text-decoration:none; color:inherit; }
.action-arrow { display:grid; place-items:center; width:34px; height:34px; flex-shrink:0; border:1px solid #694331; border-radius:50%; color:#fa8d61; font-size:19px; transition:background-color 180ms ease,color 180ms ease; }
.category-card:hover .action-arrow,
.category-action-link:hover .action-arrow { background:#ef5924; color:#0b0e10; border-color:#ef5924; }
@media(max-width:1100px) and (min-width:601px) { .category-card-inner { grid-template-columns:1fr; } .category-visual { aspect-ratio:16/10; border-right:0; border-bottom:1px solid #2b3238; } .category-content { min-height:250px; } }
@media(max-width:600px) { .category-card-inner { grid-template-columns:1fr; } .category-visual { aspect-ratio:4/3; border-right:0; border-bottom:1px solid #2b3238; } .category-content { padding:24px; min-height:245px; } h3 { font-size:25px; } }
@media(prefers-reduced-motion:reduce) { .category-card,.category-visual > img,.action-arrow { transition:none; } .category-card:hover,.category-card:hover .category-visual > img { transform:none; } }
</style>
