---
import CategoryArtwork from './CategoryArtwork.astro';

interface Props {
  name: string;
  brand?: string;
  brandSlug?: string;
  href?: string;
  description?: string;
  specs?: readonly string[];
  image?: { src: string; alt: string };
}

const { name, href = '/products', image } = Astro.props;
---

<article class="category-card">
  <a href={href} class="category-link">
    {image ? (
      <img src={image.src} alt={image.alt} loading="lazy" width="1200" height="896" class="category-image" />
    ) : (
      <CategoryArtwork name={name} />
    )}
    <div class="category-blur" aria-hidden="true"></div>
    <div class="category-caption">
      <h3 class="category-title">{name}</h3>
      <span class="category-arrow" aria-hidden="true">→</span>
    </div>
  </a>
</article>

<style>
  .category-card {
    min-width: 0;
  }

  .category-link {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 16px;
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    isolation: isolate;
  }

  .category-link :global(svg),
  .category-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .category-link:hover .category-image {
    transform: scale(1.04);
  }

  /* Progressive blur: strongest at the bottom edge, fading out upwards behind the title. */
  .category-blur {
    position: absolute;
    inset: auto 0 0;
    height: 42%;
    backdrop-filter: blur(18px) saturate(1.1);
    -webkit-backdrop-filter: blur(18px) saturate(1.1);
    background: linear-gradient(to top, rgba(14, 13, 11, 0.55), rgba(14, 13, 11, 0));
    -webkit-mask-image: linear-gradient(to top, #000 45%, transparent);
    mask-image: linear-gradient(to top, #000 45%, transparent);
  }

  .category-caption {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 1.375rem 1.375rem;
  }

  .category-title {
    font-size: clamp(1.25rem, 1.6vw, 1.5rem);
    line-height: 1.2;
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.35);
  }

  .category-arrow {
    flex: none;
    font-size: 1.125rem;
    opacity: 0.7;
    transition: transform 300ms ease, opacity 300ms ease;
  }

  .category-link:hover .category-arrow {
    transform: translateX(4px);
    opacity: 1;
  }

  .category-link:focus-visible {
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .category-image,
    .category-arrow {
      transition: none;
    }

    .category-link:hover .category-image,
    .category-link:hover .category-arrow {
      transform: none;
    }
  }
</style>
