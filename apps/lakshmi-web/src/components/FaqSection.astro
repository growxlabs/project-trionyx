---
import Container from './Container.astro';
import { faqs, type FaqItem } from '../data/faq';

interface Props {
  items?: readonly FaqItem[];
  title?: string;
  lead?: string;
  contactText?: string;
  contactHref?: string;
}

const {
  items = faqs,
  title = 'Questions, answered',
  lead = "The things workshops, dealers and owners ask us most. If yours isn't here, ask us directly.",
  contactText = 'Ask a question',
  contactHref = '/contact',
} = Astro.props;
---

<section class="faq" aria-labelledby="faq-title">
  <Container>
    <div class="faq-layout">
      <div class="faq-intro">
        <h2 id="faq-title">{title}</h2>
        <p>{lead}</p>
        <a class="text-link" href={contactHref}>{contactText} <span aria-hidden="true">→</span></a>
      </div>

      <div class="faq-list">
        {items.map((item) => (
          <details class="faq-item" name="faq">
            <summary>
              <span>{item.question}</span>
              <span class="faq-icon" aria-hidden="true"></span>
            </summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </Container>
</section>

<style>
  .faq {
    padding-block: clamp(5rem, 10vw, 9rem);
    border-top: 1px solid var(--color-hairline);
  }

  .faq-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }

  .faq-intro {
    position: sticky;
    top: 6rem;
  }

  .faq-intro h2 {
    font-size: clamp(2rem, 3.2vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .faq-intro p {
    margin-top: 1.25rem;
    max-width: 30ch;
    color: var(--color-text-muted);
  }

  .faq-intro .text-link {
    margin-top: 1rem;
  }

  .faq-list {
    border-top: 1px solid var(--color-hairline);
  }

  .faq-item {
    border-bottom: 1px solid var(--color-hairline);
  }

  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding-block: 1.375rem;
    font-size: 1.0625rem;
    cursor: pointer;
    list-style: none;
    transition: color 200ms ease;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    color: var(--color-primary-hover);
  }

  .faq-icon {
    position: relative;
    flex: none;
    width: 12px;
    height: 12px;
  }

  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 12px;
    height: 1px;
    background: var(--color-text-muted);
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .faq-icon::after {
    transform: rotate(90deg);
  }

  .faq-item[open] .faq-icon::after {
    transform: rotate(0deg);
  }

  .faq-item p {
    max-width: 60ch;
    padding-bottom: 1.5rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 52rem) {
    .faq-layout {
      grid-template-columns: 1fr;
    }

    .faq-intro {
      position: static;
    }
  }
</style>
