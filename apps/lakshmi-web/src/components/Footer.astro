---
import Container from './Container.astro';
import { categories } from '../data/catalogue';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <Container>
    <div class="footer-grid">
      <div class="footer-brand">
        <p class="footer-tagline">Built to preserve.</p>
        <p>Automotive lighting, surface protection and acoustic products for vehicle owners, workshops and dealers across India.</p>
      </div>
      <nav class="footer-col" aria-label="Footer navigation">
        <h2>Explore</h2>
        <ul>
          <li><a href="/products">Products</a></li>
          <li><a href="/brands">Brands</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </nav>
      <nav class="footer-col" aria-label="Product categories">
        <h2>Categories</h2>
        <ul>
          {categories.map((category) => (
            <li><a href={`/products?category=${category.slug}`}>{category.name}</a></li>
          ))}
        </ul>
      </nav>
      <div class="footer-col">
        <h2>Enquiries</h2>
        <p>Have a product in mind or a bulk requirement?</p>
        <a class="footer-cta" href="/contact">Talk to our team <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </Container>

  <div class="footer-wordmark" aria-hidden="true">
    <Container><span>Lakshmi</span></Container>
  </div>

  <Container>
    <div class="footer-bottom">
      <p>&copy; {year} Lakshmi Distributions</p>
      <p>Technology &amp; digital partner: <a href="https://growxlabs.tech">Growxlabs</a></p>
    </div>
  </Container>
</footer>
<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    border-top: 1px solid var(--color-hairline);
    background:
      radial-gradient(ellipse 80% 60% at 50% 100%, rgba(201, 166, 107, 0.07), transparent 70%),
      var(--color-background);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 0.8fr 1.1fr 1.2fr;
    gap: 2.5rem clamp(2rem, 4vw, 4rem);
    padding-top: clamp(4rem, 7vw, 6rem);
  }

  .footer-grid > * {
    min-width: 0;
  }

  .footer-tagline {
    font-size: clamp(1.75rem, 2.6vw, 2.25rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: var(--color-text);
  }

  .footer-brand p:not(.footer-tagline) {
    margin-top: 1rem;
    max-width: 34ch;
    font-size: var(--font-small);
    color: var(--color-text-muted);
  }

  h2 {
    margin-bottom: 1rem;
    font-size: var(--font-small);
    letter-spacing: 0;
    color: var(--color-text-faint);
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-col a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 34px;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    text-decoration: none;
    transition: color 200ms ease;
  }

  .footer-col a:hover {
    color: var(--color-text);
  }

  .footer-col p {
    font-size: var(--font-small);
    color: var(--color-text-muted);
  }

  .footer-col .footer-cta {
    margin-top: 1rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-hairline);
    border-radius: 999px;
    color: var(--color-text);
    transition: border-color 200ms ease, background-color 200ms ease;
  }

  .footer-col .footer-cta:hover {
    border-color: rgba(236, 231, 222, 0.35);
    background: rgba(236, 231, 222, 0.04);
  }

  /* Oversized wordmark that fades into the page, cropped by the bottom bar. */
  .footer-wordmark {
    margin-top: clamp(3rem, 6vw, 5rem);
    line-height: 0.78;
    pointer-events: none;
    user-select: none;
  }

  /* Sized in container units so the word spans the content width at every breakpoint. */
  .footer-wordmark :global(.container) {
    container-type: inline-size;
  }

  .footer-wordmark span {
    display: block;
    font-size: 29cqi;
    font-weight: var(--weight-medium);
    letter-spacing: -0.065em;
    margin-left: -0.04em;
    background: linear-gradient(180deg, rgba(236, 231, 222, 0.16) 0%, rgba(236, 231, 222, 0.02) 85%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .footer-bottom {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--color-hairline);
    font-size: 0.8125rem;
    color: var(--color-text-faint);
  }

  .footer-bottom a {
    color: var(--color-text-muted);
    text-decoration-color: var(--color-hairline);
  }

  @media (max-width: 64rem) {
    .footer-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 40rem) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }

    .footer-col:last-child {
      grid-column: 1 / -1;
    }
  }
</style>
