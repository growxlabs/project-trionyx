---
interface Props { name: string; }
const { name } = Astro.props;
const damping = /damping/i.test(name);
const tinted = /window/i.test(name);
const id = `material-${name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---
<svg viewBox="0 0 480 360" role="img" aria-label={`${name} material illustration`}>
  <defs>
    <linearGradient id={`${id}-sheet`} x1="0" y1="0" x2="1" y2="1">
      <stop stop-color={tinted ? '#627480' : '#b2bec5'} stop-opacity={tinted ? '.65' : '.8'} />
      <stop offset=".45" stop-color="#26343e" stop-opacity=".5" />
      <stop offset="1" stop-color="#a2b7c3" stop-opacity=".18" />
    </linearGradient>
    <linearGradient id={`${id}-roll`}><stop stop-color="#10171c"/><stop offset=".4" stop-color="#84929c"/><stop offset=".6" stop-color="#394a55"/><stop offset="1" stop-color="#11191f"/></linearGradient>
    <pattern id={`${id}-texture`} width="18" height="18" patternUnits="userSpaceOnUse" patternTransform="rotate(-18)"><path d="M2 9 9 2 16 9 9 16Z" fill="none" stroke="#9aa7b1" stroke-opacity=".2" stroke-width="1"/></pattern>
  </defs>
  <ellipse cx="240" cy="299" rx="159" ry="19" fill="#050709" opacity=".65"/>
  {damping ? <>
    <path d="m70 215 239-80 101 98-237 80Z" fill="#141d24" stroke="#35434e"/>
    <path d="m70 200 239-80 101 98-237 80Z" fill="#28343e" stroke="#5b6b78"/>
    <path d="m70 185 239-80 101 98-237 80Z" fill={`url(#${id}-sheet)`} stroke="#82919a" stroke-opacity=".7"/>
    <path d="m70 185 239-80 101 98-237 80Z" fill={`url(#${id}-texture)`}/>
    <path d="m173 283 237-80v10l-237 80Z" fill="#0c1217"/>
  </> : <>
    <path d="M103 133C129 98 161 92 191 112L372 200C319 207 301 248 264 275L102 193Z" fill={`url(#${id}-sheet)`} stroke="#a2b4c0" stroke-opacity=".45"/>
    <path d="M190 113 372 200C342 197 322 211 305 231L155 152Z" fill={`url(#${id}-sheet)`} opacity=".6"/>
    <path d="M94 126C83 124 74 139 74 160S83 196 94 201L270 284C256 255 261 226 278 211Z" fill={`url(#${id}-roll)`} stroke="#7c8d99" stroke-opacity=".5"/>
    <ellipse cx="274" cy="248" rx="24" ry="38" transform="rotate(13 274 248)" fill="#1a242c" stroke="#8796a0" stroke-width="2"/>
    <ellipse cx="274" cy="248" rx="12" ry="22" transform="rotate(13 274 248)" fill="#070b0f" stroke="#53636f"/>
    <path d="M111 133 255 202" stroke="#bdcad2" stroke-opacity=".4"/>
  </>}
  <path d="M48 306h34m-34 0v-20M432 54h-34m34 0v20" stroke="#f0784a" stroke-opacity=".6" fill="none"/>
</svg>
<style>svg { width: 100%; height: 100%; display: block; }</style>
