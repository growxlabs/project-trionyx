---
import Container from './Container.astro';

interface BrandLogo {
  name: string;
  src: string;
  class: string;
}

const BRANDS: BrandLogo[] = [
  { name: 'Aozoom', src: '/images/brands/aozoom.png', class: 'logo-aozoom' },
  { name: 'Hogonn', src: '/images/brands/hoggon.png', class: 'logo-hogonn' },
  { name: 'Trionyx', src: '/images/brands/trionyx.png', class: 'logo-trionyx' },
];
---

<section class="brand-strip" aria-labelledby="brand-strip-title">
  <Container>
    <div class="brand-strip-inner">
      <h2 id="brand-strip-title" class="brand-strip-label">Brands we distribute</h2>
      <ul class="brand-list">
        {BRANDS.map((brand) => (
          <li>
            <img src={brand.src} alt={brand.name} class={`brand-logo ${brand.class}`} loading="lazy" draggable="false" />
          </li>
        ))}
      </ul>
    </div>
  </Container>
</section>

<style>
  .brand-strip {
    border-block: 1px solid var(--color-hairline);
    padding-block: clamp(1.75rem, 3vw, 2.25rem);
  }

  .brand-strip-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .brand-strip-label {
    margin: 0;
    font-size: var(--font-small);
    font-weight: var(--weight-normal);
    letter-spacing: 0;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .brand-list {
    display: flex;
    align-items: center;
    gap: clamp(2.5rem, 7vw, 6rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Logos are rendered as a single bone tone so they sit quietly in the palette. */
  .brand-logo {
    width: auto;
    filter: brightness(0) invert(0.92) sepia(0.12);
    opacity: 0.62;
    transition: opacity 250ms ease;
  }

  .brand-logo:hover {
    opacity: 0.95;
  }

  .logo-aozoom { height: 26px; }
  .logo-hogonn { height: 50px; }
  .logo-trionyx { height: 40px; }

  @media (max-width: 48rem) {
    .brand-strip-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }

    .brand-list {
      width: 100%;
      justify-content: space-between;
      gap: 1.5rem;
    }

    .logo-aozoom { height: 16px; }
    .logo-hogonn { height: 30px; }
    .logo-trionyx { height: 26px; }
  }
</style>
