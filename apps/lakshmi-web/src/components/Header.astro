---
import Container from './Container.astro';

interface Props {
  dark?: boolean;
}

const { dark = false } = Astro.props;

const links = [
  { href: '/products', label: 'Products' },
  { href: '/brands', label: 'Brands' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => pathname === href ? 'page' : pathname.startsWith(href + '/') ? 'location' : undefined;
---

<header class:list={['site-header', { 'header-dark': dark }]} data-site-header>
  <Container>
    <div class="header-inner">
      <a class="site-brand" href="/" aria-current={pathname === '/' ? 'page' : undefined}>
        <span class="brand-text-group">
          <span class="brand-title">Lakshmi</span>
          <span class="brand-tag">Distributions</span>
        </span>
      </a>

      <nav class="desktop-nav" aria-label="Primary navigation">
        <ul class="nav-list">
          {links.map(({ href, label }) => {
            const current = isCurrent(href);
            return (
              <li>
                <a
                  href={href}
                  class:list={['nav-link', { 'is-active': Boolean(current) }]}
                  aria-current={current}
                >
                  {label}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>

      <details class="mobile-menu">
        <summary class="mobile-menu-trigger" aria-label="Toggle navigation menu">
          <span class="menu-label">Menu</span>
        </summary>
        <div class="mobile-dropdown">
          <nav aria-label="Mobile navigation">
            <ul class="mobile-nav-list">
              {links.map(({ href, label }) => (
                <li>
                  <a
                    href={href}
                    class:list={['mobile-nav-link', { 'is-active': Boolean(isCurrent(href)) }]}
                    aria-current={isCurrent(href)}
                  >
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </details>
    </div>
  </Container>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(14, 13, 11, 0.86);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--color-hairline);
    transition: transform 400ms cubic-bezier(0.16, 1, 0.3, 1), opacity 300ms ease;
  }

  /* On pages with a full-bleed hero the header stays out of the way until the hero is passed. */
  .site-header.header-scroll-reveal {
    position: fixed;
    inset-inline: 0;
    z-index: 100;
    transform: translateY(-100%);
    opacity: 0;
    pointer-events: none;
  }

  .site-header.header-scroll-reveal.is-revealed {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .header-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4.25rem;
  }

  .site-brand {
    display: inline-flex;
    text-decoration: none;
    color: var(--color-text);
  }

  .brand-text-group {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .brand-title {
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .brand-tag {
    font-size: 0.8125rem;
    color: var(--color-text-faint);
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.5vw, 2.25rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.45rem;
    transition: color 200ms ease, text-decoration-color 200ms ease;
  }

  .nav-link:hover {
    color: var(--color-text);
  }

  .nav-link.is-active {
    color: var(--color-text);
    text-decoration-color: var(--color-primary);
  }

  .mobile-menu {
    display: none;
  }

  .mobile-menu-trigger {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-text);
    font-size: 0.9375rem;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .mobile-menu-trigger::-webkit-details-marker {
    display: none;
  }

  .mobile-menu[open] .menu-label::after {
    content: ' ×';
    color: var(--color-text-muted);
  }

  .mobile-dropdown {
    position: absolute;
    top: 100%;
    inset-inline: calc(var(--page-gutter) * -1);
    background: var(--color-background);
    border-bottom: 1px solid var(--color-hairline);
    padding: 0.5rem var(--page-gutter) 1.25rem;
    z-index: 60;
  }

  .mobile-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mobile-nav-link {
    display: flex;
    align-items: center;
    min-height: 52px;
    border-bottom: 1px solid var(--color-hairline);
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 1.25rem;
  }

  .mobile-nav-link:hover,
  .mobile-nav-link.is-active {
    color: var(--color-text);
  }

  @media (max-width: 48rem) {
    .desktop-nav {
      display: none;
    }
    .mobile-menu {
      display: block;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const hero = document.querySelector<HTMLElement>('[data-hero-preserve]');

  if (header && hero) {
    header.classList.add('header-scroll-reveal');

    const checkScroll = () => {
      const heroRect = hero.getBoundingClientRect();
      // Reveal once the user scrolls past the hero section
      if (heroRect.bottom <= 60) {
        header.classList.add('is-revealed');
      } else {
        header.classList.remove('is-revealed');
      }
    };

    window.addEventListener('scroll', checkScroll, { passive: true });
    checkScroll();
  }

  // Mobile menu keyboard / click-outside handling
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  if (menu) {
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !menu.contains(event.target)) {
        menu.open = false;
      }
    });
    matchMedia('(min-width: 48rem)').addEventListener('change', () => {
      menu.open = false;
    });
  }
</script>
