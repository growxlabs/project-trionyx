---
interface BannerSlide {
  id: string;
  title: string;
  href: string;
  image: string;
  alt: string;
}

const slides: BannerSlide[] = [
  {
    id: 'paint-protection',
    title: 'Paint Protection Film',
    href: '/products?category=paint-protection-film',
    image: '/images/banners/protection-outdoor.png',
    alt: 'Vehicle with clear paint protection film in outdoor landscape',
  },
  {
    id: 'window-film',
    title: 'Sun Control Window Film',
    href: '/products?category=sun-control-ceramic-window-film',
    image: '/images/banners/window-outdoor.png',
    alt: 'Vehicle with sun control tinted window film in outdoor landscape',
  },
  {
    id: 'led-lamps',
    title: 'LED Lamps',
    href: '/products?category=led-lamps',
    image: '/images/banners/led-outdoor.png',
    alt: 'Vehicle with automotive LED lamps in outdoor landscape',
  },
  {
    id: 'sound-damping',
    title: 'Sound Damping',
    href: '/products?category=shumoff-damping',
    image: '/images/banners/sound-damping.png',
    alt: 'Automotive sound damping isolation components',
  },
];
---

<category-banners
  class="category-hero-banner"
  aria-label="Product categories"
  role="region"
  aria-roledescription="carousel"
>
  <div class="banner-track" tabindex="0">
    {slides.map((slide, index) => (
      <article
        class="banner-slide"
        aria-label={`${index + 1} of ${slides.length}: ${slide.title}`}
        aria-roledescription="slide"
        data-slide-index={index}
      >
        <img
          src={slide.image}
          alt={slide.alt}
          width="1536"
          height="1024"
          loading={index === 0 ? 'eager' : 'lazy'}
          decoding={index === 0 ? 'sync' : 'async'}
          class="banner-img"
        />
        <div class="banner-scrim" aria-hidden="true"></div>
        <div class="banner-copy">
          <h2 class="banner-title">{slide.title}</h2>
          <a href={slide.href} class="banner-btn" aria-label={`Explore ${slide.title}`}>
            Explore products
            <span class="btn-arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </article>
    ))}
  </div>

  <!-- Navigation Chevron Buttons -->
  <button type="button" class="banner-nav banner-prev" aria-label="Previous slide">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="15 18 9 12 15 6"></polyline>
    </svg>
  </button>
  <button type="button" class="banner-nav banner-next" aria-label="Next slide">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="9 18 15 12 9 6"></polyline>
    </svg>
  </button>

  <!-- Pagination Indicators -->
  <div class="banner-dots" role="tablist" aria-label="Slide indicators">
    {slides.map((_, i) => (
      <button
        type="button"
        role="tab"
        class={`dot ${i === 0 ? 'active' : ''}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        aria-label={`Go to slide ${i + 1}`}
        data-dot-index={i}
      ></button>
    ))}
  </div>
</category-banners>

<style>
  category-banners {
    display: block;
    position: relative;
    width: 100%;
    border-radius: 20px;
    overflow: hidden;
    isolation: isolate;
    background: #0B0D0F;
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
  }

  .banner-track {
    display: flex;
    width: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    scroll-behavior: smooth;
  }

  .banner-track::-webkit-scrollbar {
    display: none;
  }

  .banner-slide {
    position: relative;
    flex: 0 0 100%;
    width: 100%;
    min-height: clamp(280px, 26vw, 380px);
    overflow: hidden;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: flex;
    align-items: center;
    box-sizing: border-box;
  }

  .banner-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 72% center;
    z-index: -2;
  }

  /* Clean subtle gradient: clear text on the left, open view of vehicle on the right */
  .banner-scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      90deg,
      rgba(9, 11, 13, 0.88) 0%,
      rgba(9, 11, 13, 0.72) 36%,
      rgba(9, 11, 13, 0.25) 60%,
      transparent 80%
    );
    pointer-events: none;
  }

  .banner-copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: clamp(32px, 5vw, 60px);
    box-sizing: border-box;
    gap: 20px;
  }

  .banner-title {
    margin: 0;
    max-width: 12ch;
    font-size: clamp(2rem, 3.2vw, 3.25rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: #FFFFFF;
  }

  .banner-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 12px 22px;
    font-size: 14px;
    font-weight: 650;
    border-radius: 8px;
    color: #FFFFFF;
    background: var(--color-primary, #E95D2C);
    text-decoration: none;
    transition: background 180ms ease, transform 180ms ease;
  }

  .banner-btn:hover {
    background: #cf491c;
    transform: translateY(-1px);
  }

  .btn-arrow {
    font-size: 14px;
    line-height: 1;
    transition: transform 180ms ease;
  }

  .banner-btn:hover .btn-arrow {
    transform: translate(2px, -2px);
  }

  /* Chevron navigation buttons on left and right edges */
  .banner-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 180ms ease, border-color 180ms ease, transform 180ms ease;
  }

  .banner-nav:hover {
    background: rgba(0, 0, 0, 0.75);
    border-color: rgba(255, 255, 255, 0.5);
    transform: translateY(-50%) scale(1.05);
  }

  .banner-prev {
    left: 18px;
  }

  .banner-next {
    right: 18px;
  }

  /* Dot pagination indicators at bottom center */
  .banner-dots {
    position: absolute;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
    padding: 0;
    background: rgba(255, 255, 255, 0.4);
    cursor: pointer;
    transition: background 200ms ease, width 200ms ease, border-radius 200ms ease;
  }

  .dot.active {
    width: 22px;
    border-radius: 4px;
    background: #FFFFFF;
  }

  @media (max-width: 640px) {
    category-banners {
      border-radius: 16px;
    }

    .banner-slide {
      min-height: 240px;
      align-items: flex-end;
    }

    .banner-img {
      object-position: 70% center;
    }

    .banner-scrim {
      background: linear-gradient(
        0deg,
        rgba(9, 11, 13, 0.92) 0%,
        rgba(9, 11, 13, 0.7) 50%,
        transparent 100%
      );
    }

    .banner-copy {
      padding: 24px;
      gap: 14px;
    }

    .banner-title {
      font-size: 1.75rem;
      max-width: 14ch;
    }

    .banner-btn {
      padding: 10px 18px;
      font-size: 13px;
    }

    .banner-nav {
      display: none;
    }

    .banner-dots {
      bottom: 12px;
    }
  }
</style>

<script>
  class CategoryBanners extends HTMLElement {
    cleanup?: () => void;

    connectedCallback() {
      const track = this.querySelector<HTMLElement>('.banner-track')!;
      const slides = Array.from(this.querySelectorAll<HTMLElement>('.banner-slide'));
      const prevBtn = this.querySelector<HTMLButtonElement>('.banner-prev');
      const nextBtn = this.querySelector<HTMLButtonElement>('.banner-next');
      const dots = Array.from(this.querySelectorAll<HTMLButtonElement>('.dot'));
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

      if (!track || slides.length === 0) return;

      const controller = new AbortController();
      const options = { signal: controller.signal };
      let currentIndex = 0;
      let isHovered = false;

      const updateDots = (activeIndex: number) => {
        dots.forEach((dot, idx) => {
          const isActive = idx === activeIndex;
          dot.classList.toggle('active', isActive);
          dot.setAttribute('aria-selected', String(isActive));
        });
      };

      const goToSlide = (nextIndex: number) => {
        currentIndex = (nextIndex + slides.length) % slides.length;
        const targetSlide = slides[currentIndex];
        if (targetSlide) {
          track.scrollTo({
            left: targetSlide.offsetLeft - slides[0].offsetLeft,
            behavior: prefersReducedMotion.matches ? 'instant' : 'smooth',
          });
          updateDots(currentIndex);
        }
      };

      prevBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        goToSlide(currentIndex - 1);
      }, options);

      nextBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        goToSlide(currentIndex + 1);
      }, options);

      dots.forEach((dot, idx) => {
        dot.addEventListener('click', (e) => {
          e.preventDefault();
          goToSlide(idx);
        }, options);
      });

      this.addEventListener('mouseenter', () => { isHovered = true; }, options);
      this.addEventListener('mouseleave', () => { isHovered = false; }, options);

      // Keep active dot in sync during manual touch swiping
      track.addEventListener('scroll', () => {
        const scrollLeft = track.scrollLeft;
        let closestIndex = 0;
        let smallestDistance = Infinity;

        slides.forEach((slide, i) => {
          const distance = Math.abs(slide.offsetLeft - slides[0].offsetLeft - scrollLeft);
          if (distance < smallestDistance) {
            smallestDistance = distance;
            closestIndex = i;
          }
        });

        if (closestIndex !== currentIndex) {
          currentIndex = closestIndex;
          updateDots(currentIndex);
        }
      }, { passive: true, signal: controller.signal });

      // Auto rotation timer (pauses on hover or when out of view)
      const timer = window.setInterval(() => {
        if (
          !prefersReducedMotion.matches &&
          !isHovered &&
          !document.hidden &&
          !this.contains(document.activeElement)
        ) {
          const rect = this.getBoundingClientRect();
          const inView = rect.bottom > 0 && rect.top < window.innerHeight;
          if (inView) {
            goToSlide(currentIndex + 1);
          }
        }
      }, 6500);

      this.cleanup = () => {
        controller.abort();
        clearInterval(timer);
      };
    }

    disconnectedCallback() {
      this.cleanup?.();
    }
  }

  if (!customElements.get('category-banners')) {
    customElements.define('category-banners', CategoryBanners);
  }
</script>
