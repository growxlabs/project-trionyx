---
import SiteLayout from '../layouts/SiteLayout.astro';
import Container from '../components/Container.astro';
import CategoryCard from '../components/CategoryCard.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import FaqSection from '../components/FaqSection.astro';
import BrandMarquee from '../components/BrandMarquee.astro';
import Header from '../components/Header.astro';
import HeroBuiltToPreserve from '../components/HeroBuiltToPreserve.astro';
import { categories } from '../data/catalogue';
---

<SiteLayout title="Lakshmi Distributions | Built to Preserve">
  <Header slot="header" dark />

  <HeroBuiltToPreserve />

  <BrandMarquee />

  <section class="intro" aria-labelledby="intro-title">
    <Container>
      <div class="intro-grid">
        <h2 id="intro-title" class="kicker"></h2>
        <div>
          <p class="intro-statement">
            We supply retailers, workshops and installers across India with automotive lighting, protection films and
            acoustic materials, <span>sourced directly from the manufacturers who make them.</span>
          </p>
          <a class="text-link" href="/about">More about us <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </Container>
  </section>

  <section class="categories" aria-labelledby="categories-title">
    <Container>
      <div class="section-head">
        <h2 id="categories-title">What we carry</h2>
        <a class="text-link" href="/products">All products <span aria-hidden="true">→</span></a>
      </div>
      <div class="category-grid">
        {categories.map((category) => (
          <CategoryCard
            name={category.name}
            href={`/products?category=${category.slug}`}
            image={category.image}
          />
        ))}
      </div>
    </Container>
  </section>

  <TestimonialsSection />

  <FaqSection />

</SiteLayout>

<style>
  .intro {
    padding-block: clamp(5rem, 11vw, 10rem);
  }

  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    gap: 2rem clamp(2rem, 5vw, 5rem);
  }

  .intro-grid h2 {
    margin: 0;
    padding-top: 0.6rem;
    font-size: var(--font-small);
    letter-spacing: 0;
  }

  .intro-statement {
    max-width: 30ch;
    font-size: clamp(1.75rem, 3.4vw, 3rem);
    line-height: 1.18;
    letter-spacing: -0.025em;
    text-wrap: pretty;
  }

  .intro-statement span {
    color: var(--color-text-muted);
  }

  .intro-grid .text-link {
    margin-top: 2rem;
  }

  .categories {
    padding-bottom: clamp(5rem, 10vw, 9rem);
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .section-head h2 {
    font-size: clamp(2rem, 3.2vw, 3rem);
    letter-spacing: -0.025em;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
  }

  @media (max-width: 64rem) {
    .category-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 48rem) {
    .intro-grid {
      grid-template-columns: 1fr;
    }

    .intro-grid h2 {
      padding-top: 0;
    }
  }

  @media (max-width: 30rem) {
    .category-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
