---
import SiteLayout from '../layouts/SiteLayout.astro';
import '../../../../packages/ui/src/status.css';
---
<SiteLayout title="Page not found" description="This page could not be found. Return to Lakshmi Distributions to explore products and brands.">
  <meta slot="head" name="robots" content="noindex" />
  <section class="tx-status-page tx-status-embedded" aria-labelledby="status-heading">
    <div class="tx-status-body">
      <div class="tx-status-art" aria-hidden="true">
        <span class="tx-status-code">404</span>
        <div class="tx-status-icon-frame">
          <svg class="tx-status-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 7.5L5.5 4h13l2 3.5"/><path d="M3.5 7.5v11a1 1 0 0 0 1 1h15a1 1 0 0 0 1-1v-11H3.5z"/><path d="M7.5 7.5v4.5a0.5.5 0 0 0 .5.5h8a0.5.5 0 0 0 .5-.5V7.5"/><path d="M9 16h6"/><circle cx="12" cy="16" r=".75" fill="currentColor"/></svg>
        </div>
        <span class="tx-status-art-label">No matching page</span>
      </div>
      <div class="tx-status-copy">
        <p class="tx-status-eyebrow">Page not found</p>
        <h1 id="status-heading">This link leads<br />to an empty bay.</h1>
        <p class="tx-status-description">The page may have moved, or the link may be out of date. Check the address or return to a familiar place.</p>
        <div class="tx-status-actions"><a class="tx-status-primary" href="/">Back to home <span aria-hidden="true">→</span></a><a class="tx-status-secondary" href="/products">Explore products</a></div>
        <p class="tx-status-footnote">Looking for something specific? <a href="/contact">Contact our team.</a></p>
      </div>
    </div>
  </section>
</SiteLayout>
