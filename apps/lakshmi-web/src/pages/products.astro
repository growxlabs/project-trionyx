---
import SiteLayout from '../layouts/SiteLayout.astro';
import Container from '../components/Container.astro';
import PageIntro from '../components/PageIntro.astro';
import ProductCard from '../components/ProductCard.astro';
import { publicCatalogueService } from '@trionyx/api/catalogue';
import { categories as fallbackCategories } from '../data/catalogue';

interface CategoryItem {
  id?: string;
  name: string;
  slug: string;
  brandSlug?: string | null;
}

let products: any[] = [];
let categories: CategoryItem[] = [];

try {
  const [productsResult, categoriesResult] = await Promise.all([
    publicCatalogueService.listPublishedProducts('LAKSHMI'),
    publicCatalogueService.listPublishedCategories('LAKSHMI'),
  ]);
  products = productsResult.items;
  categories = categoriesResult.length > 0 ? categoriesResult : [...fallbackCategories];
} catch (err) {
  console.error('[Products Page] Failed to fetch catalogue from database:', err);
  categories = [...fallbackCategories];
}
---

<SiteLayout
  title="Catalogue | Lakshmi Distributions"
  description="Browse automotive lighting, protection and damping products available through Lakshmi Distributions."
>
  <Container>
    <PageIntro
      kicker="Catalogue"
      title="Explore the catalogue."
      lead="Lighting from Aozoom, and surface protection, window film and acoustic damping from Hogonn."
    />

    <div class="catalogue-toolbar" role="toolbar" aria-label="Catalogue filters">
      <div class="brand-tabs" role="tablist" aria-label="Filter by brand">
        <button type="button" role="tab" aria-selected="true" class="brand-tab active" data-brand="all">All</button>
        <button type="button" role="tab" aria-selected="false" class="brand-tab" data-brand="aozoom">Aozoom</button>
        <button type="button" role="tab" aria-selected="false" class="brand-tab" data-brand="hogonn">Hogonn</button>
      </div>

      <div class="select-box">
        <label for="category-select" class="visually-hidden">Filter by category</label>
        <select id="category-select" class="category-select">
          <option value="all">All categories</option>
          {categories.map((c) => (
            <option value={c.slug} data-brand={c.brandSlug || (c.slug === 'led-lamps' ? 'aozoom' : 'hogonn')}>
              {c.name}
            </option>
          ))}
        </select>
        <svg class="select-caret" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M3 4.5 6 7.5l3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </div>
    </div>

    <section class="catalogue-results" aria-labelledby="products-grid-heading">
      <h2 id="products-grid-heading" class="visually-hidden">Products</h2>
      <div id="products-grid" class="products-grid">
        {products.map((product) => (
          <div
            class="product-grid-item"
            data-brand={(product.brandSlug || 'aozoom').toLowerCase()}
            data-category={(product.categorySlug || 'led-lamps').toLowerCase()}
          >
            <ProductCard
              name={product.name}
              href={`/products/${product.slug}`}
              brand={product.brandName}
              category={product.categoryName}
              specification={product.keySpecification ? `${product.keySpecification.label}: ${product.keySpecification.value}` : null}
              image={product.primaryImage ? { src: product.primaryImage.url, alt: product.primaryImage.altText || product.name } : null}
            />
          </div>
        ))}
      </div>

      <div id="filter-empty-state" class="products-empty" style="display: none;">
        <p class="empty-title">Nothing here yet.</p>
        <p class="empty-desc">No products match this brand and category. Try another selection.</p>
        <button type="button" id="reset-filter-btn" class="text-link reset-filter-link">Clear filters</button>
      </div>
    </section>
  </Container>
</SiteLayout>

<script>
  function setupCatalogueFilters() {
    const brandTabs = document.querySelectorAll<HTMLButtonElement>('.brand-tab');
    const categorySelect = document.getElementById('category-select') as HTMLSelectElement | null;
    const items = document.querySelectorAll<HTMLElement>('.product-grid-item');
    const emptyState = document.getElementById('filter-empty-state');
    const grid = document.getElementById('products-grid');
    const resetBtn = document.getElementById('reset-filter-btn');

    if (!categorySelect || items.length === 0) return;

    let currentBrand = 'all';
    let currentCategory = 'all';

    // Parse initial URL parameters
    const params = new URLSearchParams(window.location.search);
    const initialCategory = params.get('category');
    const initialBrand = params.get('brand');

    if (initialCategory) {
      currentCategory = initialCategory.toLowerCase();
      categorySelect.value = initialCategory;
      const opt = Array.from(categorySelect.options).find(
        (o) => o.value.toLowerCase() === initialCategory.toLowerCase()
      ) || null;
      if (opt && opt.dataset.brand) {
        currentBrand = opt.dataset.brand.toLowerCase();
      }
    } else if (initialBrand) {
      currentBrand = normalizeBrand(initialBrand);
    }

    // Apply active tab
    function updateBrandTabUI() {
      brandTabs.forEach((tab) => {
        const b = (tab.dataset.brand || '').toLowerCase();
        const isActive = b === currentBrand;
        tab.classList.toggle('active', isActive);
        tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });
    }

    // Filter dropdown options based on selected brand
    function updateCategoryDropdown() {
      if (!categorySelect) return;
      const options = categorySelect.querySelectorAll<HTMLOptionElement>('option');
      options.forEach((opt) => {
        if (opt.value === 'all') return;
        const optBrand = (opt.dataset.brand || '').toLowerCase();
        const isMatch = currentBrand === 'all' || optBrand === currentBrand;
        opt.hidden = !isMatch;
        opt.disabled = !isMatch;
      });

      const currentOpt = Array.from(categorySelect.options).find(
        (o) => o.value.toLowerCase() === currentCategory.toLowerCase()
      ) || null;
      if (currentOpt && currentOpt.disabled) {
        currentCategory = 'all';
        categorySelect.value = 'all';
      }
    }

    function normalizeBrand(b: string): string {
      const lower = b.toLowerCase();
      if (lower === 'azoom') return 'aozoom';
      if (lower === 'hoggon') return 'hogonn';
      return lower;
    }

    function applyFilter() {
      let visibleCount = 0;

      items.forEach((item) => {
        const itemBrand = (item.dataset.brand || '').toLowerCase();
        const itemCategory = (item.dataset.category || '').toLowerCase();

        const matchesBrand = currentBrand === 'all' || normalizeBrand(itemBrand) === normalizeBrand(currentBrand);
        const matchesCategory = currentCategory === 'all' || itemCategory === currentCategory;

        if (matchesBrand && matchesCategory) {
          item.style.display = '';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (emptyState && grid) {
        if (visibleCount === 0) {
          emptyState.style.display = 'block';
          grid.style.display = 'none';
        } else {
          emptyState.style.display = 'none';
          grid.style.display = 'grid';
        }
      }

      // Update URL query params without reloading
      const url = new URL(window.location.href);
      if (currentBrand !== 'all') {
        url.searchParams.set('brand', currentBrand);
      } else {
        url.searchParams.delete('brand');
      }
      if (currentCategory !== 'all') {
        url.searchParams.set('category', currentCategory);
      } else {
        url.searchParams.delete('category');
      }
      window.history.replaceState({}, '', url.toString());
    }

    brandTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        currentBrand = (tab.dataset.brand || 'all').toLowerCase();
        updateBrandTabUI();
        updateCategoryDropdown();
        applyFilter();
      });
    });

    categorySelect.addEventListener('change', () => {
      currentCategory = categorySelect.value.toLowerCase();
      const selectedOpt = categorySelect.querySelector(`option[value="${currentCategory}"]`) as HTMLOptionElement | null;
      if (selectedOpt && selectedOpt.dataset.brand && currentBrand !== 'all' && selectedOpt.dataset.brand.toLowerCase() !== currentBrand) {
        currentBrand = selectedOpt.dataset.brand.toLowerCase();
        updateBrandTabUI();
      }
      applyFilter();
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        currentBrand = 'all';
        currentCategory = 'all';
        categorySelect.value = 'all';
        updateBrandTabUI();
        updateCategoryDropdown();
        applyFilter();
      });
    }

    updateBrandTabUI();
    updateCategoryDropdown();
    applyFilter();
  }

  setupCatalogueFilters();
  document.addEventListener('astro:page-load', setupCatalogueFilters);
</script>

<style>
  .catalogue-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.5rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--color-hairline);
  }

  /* Segmented control, styled like the testimonial stepper pill. */
  .brand-tabs {
    display: inline-flex;
    gap: 0.25rem;
    padding: 0.25rem;
    background: rgba(236, 231, 222, 0.07);
    border: 1px solid var(--color-hairline);
    border-radius: 999px;
  }

  .brand-tab {
    min-height: 40px;
    padding: 0 1.125rem;
    background: transparent;
    border: 0;
    border-radius: 999px;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    cursor: pointer;
    transition: background-color 250ms ease, color 250ms ease;
  }

  .brand-tab:hover {
    color: var(--color-text);
  }

  .brand-tab.active {
    background: var(--color-text);
    color: var(--color-on-primary);
  }

  .select-box {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .category-select {
    appearance: none;
    -webkit-appearance: none;
    min-width: 14rem;
    min-height: 48px;
    padding: 0 2.75rem 0 1.25rem;
    background: rgba(236, 231, 222, 0.07);
    border: 1px solid var(--color-hairline);
    border-radius: 999px;
    color: var(--color-text);
    font: inherit;
    font-size: 0.9375rem;
    cursor: pointer;
    transition: border-color 200ms ease;
  }

  .category-select:hover,
  .category-select:focus-visible {
    border-color: rgba(236, 231, 222, 0.3);
  }

  .category-select option {
    background: var(--color-surface);
    color: var(--color-text);
  }

  .select-caret {
    position: absolute;
    right: 1.125rem;
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .catalogue-results {
    min-height: 30vh;
    padding-bottom: clamp(5rem, 10vw, 9rem);
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 3rem clamp(0.75rem, 1.5vw, 1.25rem);
  }

  @media (max-width: 75rem) {
    .products-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 56rem) {
    .products-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 30rem) {
    .products-grid {
      grid-template-columns: 1fr;
    }
  }

  .products-empty {
    padding-block: clamp(3rem, 8vw, 6rem);
    text-align: center;
  }

  .empty-title {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    letter-spacing: -0.02em;
  }

  .empty-desc {
    margin-top: 0.75rem;
    color: var(--color-text-muted);
  }

  .reset-filter-link {
    margin-top: 1rem;
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    cursor: pointer;
  }

  @media (max-width: 40rem) {
    .catalogue-toolbar {
      flex-direction: column;
      align-items: stretch;
    }

    .brand-tabs {
      display: flex;
    }

    .brand-tab {
      flex: 1;
    }

    .category-select {
      width: 100%;
    }
  }
</style>
