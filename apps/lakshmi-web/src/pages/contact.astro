---
import SiteLayout from '../layouts/SiteLayout.astro';
import Container from '../components/Container.astro';

const INDIAN_STATES = [
  'Andhra Pradesh', 'Arunachal Pradesh', 'Assam', 'Bihar', 'Chhattisgarh',
  'Goa', 'Gujarat', 'Haryana', 'Himachal Pradesh', 'Jharkhand',
  'Karnataka', 'Kerala', 'Madhya Pradesh', 'Maharashtra', 'Manipur',
  'Meghalaya', 'Mizoram', 'Nagaland', 'Odisha', 'Punjab',
  'Rajasthan', 'Sikkim', 'Tamil Nadu', 'Telangana', 'Tripura',
  'Uttar Pradesh', 'Uttarakhand', 'West Bengal',
  'Andaman & Nicobar', 'Chandigarh', 'Dadra & Nagar Haveli and Daman & Diu',
  'Delhi', 'Jammu & Kashmir', 'Ladakh', 'Lakshadweep', 'Puducherry',
];
---

<SiteLayout
  title="Contact Us | Lakshmi Distributions"
  description="Get in touch with Lakshmi Distributions for trade enquiries, automotive lighting solutions, and distribution partnerships."
>
  <Container>
    <section class="contact" aria-labelledby="contact-heading">
      <div class="contact-intro">
        <span class="kicker">Contact</span>
        <h1 id="contact-heading">Tell us what you need.</h1>
        <p class="contact-lead">
          Product enquiries, dealer and workshop accounts, or distribution partnerships. Send us the details and our team
          will get back to you.
        </p>
        <div class="contact-media">
          <img src="/images/studio/window-film.jpg" alt="Tinted window film curling away from a dark car door" loading="eager" />
        </div>
      </div>

      <div class="contact-form-wrapper">
        <div id="enquiry-success-view" class="success-banner" style="display: none;" role="status" aria-live="polite">
          <span class="kicker">Enquiry received</span>
          <h2 class="success-title">Thank you. We'll be in touch shortly.</h2>
          <p class="success-lead">Our team has your enquiry. Keep this reference handy if you contact us about it.</p>
          <p class="success-code">
            <span class="code-label">Reference</span>
            <span id="reference-code-display" class="code-value">TRX-ENQ-000000</span>
          </p>
          <button type="button" id="submit-another-btn" class="text-link reset-button">Send another enquiry</button>
        </div>

        <form id="lakshmi-contact-form" class="enquiry-form" novalidate>
          <!-- Honeypot anti-spam field -->
          <input type="text" name="website" id="field-website" tabindex="-1" autocomplete="off" style="position: absolute; left: -9999px; opacity: 0;" />

          <div id="form-error-banner" class="form-error-banner" style="display: none;" role="alert"></div>

          <div id="product-context-banner" class="product-context-box" style="display: none;">
            <span class="product-badge">Enquiring about</span>
            <span id="product-context-title" class="product-title-text"></span>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="field-fullName" class="form-label">Full name <span class="required" aria-hidden="true">*</span></label>
              <input type="text" id="field-fullName" name="fullName" class="form-input" required autocomplete="name" placeholder="Ramesh Kumar" />
              <span class="field-error" id="err-fullName"></span>
            </div>
            <div class="form-group">
              <label for="field-phone" class="form-label">Phone number <span class="required" aria-hidden="true">*</span></label>
              <input type="tel" id="field-phone" name="phone" class="form-input" required autocomplete="tel" placeholder="10-digit mobile number" />
              <span class="field-error" id="err-phone"></span>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="field-email" class="form-label">Email <span class="required" aria-hidden="true">*</span></label>
              <input type="email" id="field-email" name="email" class="form-input" required autocomplete="email" placeholder="you@company.com" />
              <span class="field-error" id="err-email"></span>
            </div>
            <div class="form-group">
              <label for="field-type" class="form-label">Enquiry type <span class="required" aria-hidden="true">*</span></label>
              <div class="select-wrap">
                <select id="field-type" name="type" class="form-select" required>
                  <option value="PRODUCT_ENQUIRY">Product enquiry</option>
                  <option value="DEALER_ENQUIRY">Dealer / workshop enquiry</option>
                  <option value="DISTRIBUTION_ENQUIRY">Distribution partnership</option>
                  <option value="PRODUCT_SUPPORT">Product support</option>
                  <option value="GENERAL_ENQUIRY">General enquiry</option>
                </select>
              </div>
              <span class="field-error" id="err-type"></span>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="field-companyName" class="form-label">Company / workshop</label>
              <input type="text" id="field-companyName" name="companyName" class="form-input" autocomplete="organization" placeholder="Optional" />
            </div>
            <div class="form-group">
              <label for="field-state" class="form-label">State <span class="required" aria-hidden="true">*</span></label>
              <div class="select-wrap">
                <select id="field-state" name="state" class="form-select" required>
                  <option value="">Select state</option>
                  {INDIAN_STATES.map((state) => (
                    <option value={state}>{state}</option>
                  ))}
                </select>
              </div>
              <span class="field-error" id="err-state"></span>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="field-city" class="form-label">City <span class="required" aria-hidden="true">*</span></label>
              <input type="text" id="field-city" name="city" class="form-input" required autocomplete="address-level2" placeholder="Coimbatore" />
              <span class="field-error" id="err-city"></span>
            </div>
            <div class="form-group">
              <label for="field-pincode" class="form-label">Pincode <span class="required" aria-hidden="true">*</span></label>
              <input type="text" id="field-pincode" name="pincode" class="form-input" required inputmode="numeric" autocomplete="postal-code" placeholder="6-digit pincode" maxlength="6" />
              <span class="field-error" id="err-pincode"></span>
            </div>
          </div>

          <div class="form-group">
            <label for="field-message" class="form-label">Message <span class="required" aria-hidden="true">*</span></label>
            <textarea id="field-message" name="message" class="form-textarea" rows="5" required placeholder="Your requirements, vehicle models or quantities"></textarea>
            <span class="field-error" id="err-message"></span>
          </div>

          <div class="form-footer">
            <button type="submit" id="submit-button" class="button submit-btn">
              <span class="btn-text">Send enquiry</span>
              <span class="btn-loading" style="display: none;">Sending…</span>
            </button>
            <p class="form-note"><span aria-hidden="true">*</span> Required</p>
          </div>
        </form>
      </div>
    </section>
  </Container>
</SiteLayout>

<script>
  function initContactPage() {
    const urlParams = new URLSearchParams(window.location.search);
    const productName = urlParams.get('product');
    const productCode = urlParams.get('code');

    const productBox = document.getElementById('product-context-banner');
    const productTitle = document.getElementById('product-context-title');
    const messageInput = document.getElementById('field-message') as HTMLTextAreaElement | null;

    if (productName && productBox && productTitle) {
      productTitle.textContent = `${productName} (${productCode || ''})`.trim();
      productBox.style.display = 'flex';
      if (messageInput && !messageInput.value) {
        messageInput.value = `I am interested in acquiring or learning more about ${productName} (Code: ${productCode || 'N/A'}). Please share availability and technical guidance.`;
      }
    }

    const form = document.getElementById('lakshmi-contact-form') as HTMLFormElement | null;
    const successView = document.getElementById('enquiry-success-view');
    const referenceCodeDisplay = document.getElementById('reference-code-display');
    const submitAnotherBtn = document.getElementById('submit-another-btn');
    const errorBanner = document.getElementById('form-error-banner');
    const submitBtn = document.getElementById('submit-button');

    if (!form || !successView) return;

    submitAnotherBtn?.addEventListener('click', () => {
      form.reset();
      form.style.display = 'flex';
      successView.style.display = 'none';
      if (errorBanner) errorBanner.style.display = 'none';
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Clear previous error messages
      document.querySelectorAll('.field-error').forEach((el) => {
        el.textContent = '';
      });
      if (errorBanner) {
        errorBanner.style.display = 'none';
        errorBanner.textContent = '';
      }

      const formData = new FormData(form);
      const fullName = String(formData.get('fullName') || '').trim();
      const phone = String(formData.get('phone') || '').trim();
      const email = String(formData.get('email') || '').trim();
      const type = String(formData.get('type') || '').trim();
      const companyName = String(formData.get('companyName') || '').trim();
      const state = String(formData.get('state') || '').trim();
      const city = String(formData.get('city') || '').trim();
      const pincode = String(formData.get('pincode') || '').trim();
      const message = String(formData.get('message') || '').trim();
      const website = String(formData.get('website') || '').trim();

      let hasError = false;

      function setError(fieldId: string, msg: string) {
        const el = document.getElementById(`err-${fieldId}`);
        if (el) el.textContent = msg;
        hasError = true;
      }

      if (!fullName || fullName.length < 2) {
        setError('fullName', 'Please enter your full name (at least 2 characters)');
      }
      const cleanPhone = phone.replace(/[^0-9+]/g, '');
      if (!cleanPhone || cleanPhone.length < 10) {
        setError('phone', 'Please enter a valid mobile number (at least 10 digits)');
      }
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        setError('email', 'Please enter a valid email address');
      }
      if (!type) {
        setError('type', 'Please select an enquiry type');
      }
      if (!state) {
        setError('state', 'Please select your state');
      }
      if (!city || city.length < 2) {
        setError('city', 'Please enter your city');
      }
      if (!pincode || pincode.length < 6) {
        setError('pincode', 'Please enter a valid 6-digit pincode');
      }
      if (!message || message.length < 5) {
        setError('message', 'Please provide a message or details of your requirements');
      }

      if (hasError) return;

      // Determine API endpoint: Use local/relative or fallback to port 3000 in dev
      const apiOrigin = window.location.port === '4321' ? 'http://localhost:3000' : '';
      const endpoint = `${apiOrigin}/api/v1/public/contact-enquiries`;

      const btnText = submitBtn?.querySelector('.btn-text') as HTMLElement | null;
      const btnLoading = submitBtn?.querySelector('.btn-loading') as HTMLElement | null;

      if (submitBtn) (submitBtn as HTMLButtonElement).disabled = true;
      if (btnText) btnText.style.display = 'none';
      if (btnLoading) btnLoading.style.display = 'inline-block';

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            type,
            fullName,
            phone: cleanPhone,
            email,
            companyName: companyName || undefined,
            state,
            city,
            pincode,
            message: productName ? `[Product: ${productName} (${productCode || 'N/A'})] ${message}` : message,
            website, // honeypot
          }),
        });

        const data = await res.json().catch(() => ({}));

        if (!res.ok || data.error) {
          const errMsg = data.error?.message || 'Failed to submit enquiry. Please check your information and try again.';
          if (errorBanner) {
            errorBanner.textContent = errMsg;
            errorBanner.style.display = 'block';
          }
          return;
        }

        const enquiryCode = data.data?.enquiryCode || 'TRX-ENQ-SUBMITTED';
        if (referenceCodeDisplay) {
          referenceCodeDisplay.textContent = enquiryCode;
        }
        form.style.display = 'none';
        successView.style.display = 'block';
      } catch (err) {
        if (errorBanner) {
          errorBanner.textContent = 'Network error connecting to the enquiry service. Please verify your connection or try again shortly.';
          errorBanner.style.display = 'block';
        }
      } finally {
        if (submitBtn) (submitBtn as HTMLButtonElement).disabled = false;
        if (btnText) btnText.style.display = 'inline-block';
        if (btnLoading) btnLoading.style.display = 'none';
      }
    });
  }

  // Initialize on load and on view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContactPage);
  } else {
    initContactPage();
  }
  document.addEventListener('astro:page-load', initContactPage);
</script>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    gap: 3rem clamp(2.5rem, 6vw, 6rem);
    align-items: start;
    padding-block: clamp(4rem, 9vw, 7.5rem) clamp(5rem, 10vw, 9rem);
  }

  .contact-intro {
    position: sticky;
    top: 6rem;
  }

  h1 {
    margin-top: 1.25rem;
    font-size: clamp(2.5rem, 5vw, 4.25rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .contact-lead {
    margin-top: 1.5rem;
    max-width: 40ch;
    font-size: 1.0625rem;
    color: var(--color-text-muted);
  }

  .contact-media {
    margin-top: clamp(2rem, 4vw, 3rem);
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 16px;
    background: var(--color-surface);
  }

  .contact-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Form */
  .enquiry-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }

  .form-label {
    font-size: var(--font-small);
    color: var(--color-text-muted);
  }

  .required {
    color: var(--color-primary);
  }

  .form-input,
  .form-select,
  .form-textarea {
    width: 100%;
    min-height: 52px;
    padding: 0 1.125rem;
    background: rgba(236, 231, 222, 0.05);
    border: 1px solid var(--color-hairline);
    border-radius: 12px;
    color: var(--color-text);
    font: inherit;
    font-size: 0.9375rem;
    transition: border-color 200ms ease, background-color 200ms ease;
  }

  .form-input::placeholder,
  .form-textarea::placeholder {
    color: var(--color-text-faint);
  }

  .form-input:hover,
  .form-select:hover,
  .form-textarea:hover {
    border-color: rgba(236, 231, 222, 0.22);
  }

  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    outline: none;
    border-color: var(--color-text);
    background: rgba(236, 231, 222, 0.07);
  }

  .select-wrap {
    position: relative;
  }

  .select-wrap::after {
    content: '';
    position: absolute;
    top: 50%;
    right: 1.125rem;
    width: 7px;
    height: 7px;
    border-right: 1.5px solid var(--color-text-muted);
    border-bottom: 1.5px solid var(--color-text-muted);
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
  }

  .form-select {
    appearance: none;
    -webkit-appearance: none;
    padding-right: 2.75rem;
    cursor: pointer;
  }

  .form-select option {
    background: var(--color-surface);
    color: var(--color-text);
  }

  .form-textarea {
    min-height: 9rem;
    padding-block: 0.875rem;
    resize: vertical;
  }

  .field-error {
    min-height: 1em;
    font-size: 0.8125rem;
    color: #E8907A;
  }

  .field-error:empty {
    min-height: 0;
  }

  .form-error-banner {
    padding: 0.875rem 1.125rem;
    border: 1px solid rgba(232, 144, 122, 0.4);
    border-radius: 12px;
    background: rgba(232, 144, 122, 0.08);
    font-size: var(--font-small);
    color: #E8907A;
  }

  .product-context-box {
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-hairline);
    border-radius: 12px;
    background: rgba(236, 231, 222, 0.05);
  }

  .product-badge {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .product-title-text {
    font-size: 1rem;
  }

  .form-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .submit-btn {
    min-width: 12rem;
  }

  .submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .form-note {
    font-size: 0.8125rem;
    color: var(--color-text-faint);
  }

  /* Success */
  .success-banner {
    padding-top: 1rem;
  }

  .success-title {
    margin-top: 1rem;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .success-lead {
    margin-top: 1rem;
    max-width: 44ch;
    color: var(--color-text-muted);
  }

  .success-code {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 2rem;
    padding-block: 1.25rem;
    border-block: 1px solid var(--color-hairline);
  }

  .code-label {
    font-size: var(--font-small);
    color: var(--color-text-faint);
  }

  .code-value {
    font-size: 1.5rem;
    letter-spacing: 0.02em;
  }

  .reset-button {
    margin-top: 1.5rem;
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    cursor: pointer;
  }

  @media (max-width: 56rem) {
    .contact {
      grid-template-columns: 1fr;
    }

    .contact-intro {
      position: static;
    }

    .contact-media {
      aspect-ratio: 16 / 9;
    }
  }

  @media (max-width: 36rem) {
    .form-row {
      grid-template-columns: 1fr;
    }

    .form-footer {
      flex-direction: column;
      align-items: stretch;
    }

    .submit-btn {
      width: 100%;
    }
  }
</style>
