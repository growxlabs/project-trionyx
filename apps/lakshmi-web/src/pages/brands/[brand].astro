---
import type { GetStaticPaths } from 'astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Container from '../../components/Container.astro';
import Section from '../../components/Section.astro';
import Button from '../../components/Button.astro';
import CategoryCard from '../../components/CategoryCard.astro';
import ProductCard from '../../components/ProductCard.astro';
import EnquiryCTA from '../../components/EnquiryCTA.astro';
import { publicCatalogueService } from '@trionyx/api/catalogue';
import '../../styles/discovery.css';

export const getStaticPaths = (async () => {
  try {
    const brands = await publicCatalogueService.listPublishedBrands('LAKSHMI');
    return brands.map((brand) => ({
      params: { brand: brand.slug },
      props: { brand },
    }));
  } catch (err) {
    console.error('[Brand Detail] Failed to get static paths:', err);
    return [];
  }
}) satisfies GetStaticPaths;

interface Props {
  brand: {
    id: string;
    slug: string;
    name: string;
    description?: string | null;
  };
}

const { brand } = Astro.props;
const [brandCategories, { items: brandProducts }] = await Promise.all([
  publicCatalogueService.listPublishedCategories('LAKSHMI', brand.slug),
  publicCatalogueService.listPublishedProducts('LAKSHMI', { brandSlug: brand.slug }),
]);

const brandLogo = brand.slug === 'hoggon' ? '/images/brands/hoggon.png' : '/images/brands/azoom.png';
const brandImage = brand.slug === 'hoggon' ? '/images/categories/paint-protection.jpg' : '/images/about/about-secondary.jpg';
const brandImageAlt = brand.slug === 'hoggon' ? 'Hoggon automotive surface protection and film engineering' : `${brand.name} automotive lighting engineering`;
---

<SiteLayout title={brand.name} description={brand.description || `Explore ${brand.name} products.`}>
  <Section labelledBy="page-title">
    <Container>
      <a class="discovery-back" href="/brands"><span aria-hidden="true">←</span> All brands</a>
      <div class="brand-hero">
        <div class="brand-hero-copy">
          <div class="brand-badge-header">
            <span class="discovery-eyebrow">BRAND</span>
            <div class="brand-logo-badge">
              <img src={brandLogo} alt={`${brand.name} logo`} class="brand-logo-img" />
            </div>
          </div>
          <h1 id="page-title">{brand.name}</h1>
          <p class="text-muted text-width">{brand.description || `Explore ${brand.name} automotive products.`}</p>
          <Button href="/products">Explore Products</Button>
        </div>
        <div class="brand-hero-visual">
          <img
            src={brandImage}
            alt={brandImageAlt}
            class="brand-hero-img"
          />
        </div>
      </div>
    </Container>
  </Section>

  {brandCategories.length > 0 && (
    <Section labelledBy="categories-title">
      <Container>
        <div class="stack discovery-heading">
          <p class="discovery-eyebrow">CATEGORIES</p>
          <h2 id="categories-title">Explore by category</h2>
        </div>
        <div class="discovery-grid">
          {brandCategories.map((category) => (
            <CategoryCard
              name={category.name}
              brand={brand.name}
              href={`/products?category=${category.slug}`}
              description={category.description || undefined}
            />
          ))}
        </div>
      </Container>
    </Section>
  )}

  {brandProducts.length > 0 && (
    <Section labelledBy="brand-products-title">
      <Container>
        <div class="stack discovery-heading">
          <p class="discovery-eyebrow">PRODUCTS</p>
          <h2 id="brand-products-title">{brand.name} Products</h2>
        </div>
        <div class="discovery-grid">
          {brandProducts.map((product) => (
            <ProductCard
              name={product.name}
              href={`/products/${product.slug}`}
              brand={product.brandName}
              category={product.categoryName}
              specification={product.keySpecification ? `${product.keySpecification.label}: ${product.keySpecification.value}` : null}
              image={product.primaryImage ? { src: product.primaryImage.url, alt: product.primaryImage.altText || product.name } : null}
            />
          ))}
        </div>
      </Container>
    </Section>
  )}

  <EnquiryCTA />
</SiteLayout>

<style>
  .brand-badge-header {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .brand-logo-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #121518;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 6px 14px;
    height: 36px;
    box-sizing: border-box;
  }
  .brand-logo-img {
    max-height: 22px;
    max-width: 110px;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .brand-hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-md);
  }
</style>
