---
import type { GetStaticPaths } from 'astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Container from '../../components/Container.astro';
import CategoryCard from '../../components/CategoryCard.astro';
import ProductCard from '../../components/ProductCard.astro';
import { publicCatalogueService } from '@trionyx/api/catalogue';
import { getBrandMedia, getCategoryImage } from '../../data/brandMedia';

export const getStaticPaths = (async () => {
  try {
    const brands = await publicCatalogueService.listPublishedBrands('LAKSHMI');
    const paths = brands.map((brand) => ({
      params: { brand: brand.slug },
      props: { brand },
    }));

    // Support canonical aliases so both /brands/aozoom and /brands/azoom, /brands/hogonn and /brands/hoggon work
    const azoomBrand = brands.find((b) => b.slug === 'azoom' || b.slug === 'aozoom');
    if (azoomBrand && !paths.some((p) => p.params.brand === 'aozoom')) {
      paths.push({ params: { brand: 'aozoom' }, props: { brand: azoomBrand } });
    }
    const hoggonBrand = brands.find((b) => b.slug === 'hoggon' || b.slug === 'hogonn');
    if (hoggonBrand && !paths.some((p) => p.params.brand === 'hogonn')) {
      paths.push({ params: { brand: 'hogonn' }, props: { brand: hoggonBrand } });
    }

    return paths;
  } catch (err) {
    console.error('[Brand Detail] Failed to get static paths:', err);
    return [];
  }
}) satisfies GetStaticPaths;

interface Props {
  brand: {
    id: string;
    slug: string;
    name: string;
    description?: string | null;
  };
}

const { brand } = Astro.props;
const [brandCategories, { items: brandProducts }] = await Promise.all([
  publicCatalogueService.listPublishedCategories('LAKSHMI', brand.slug),
  publicCatalogueService.listPublishedProducts('LAKSHMI', { brandSlug: brand.slug }),
]);

const media = getBrandMedia(brand.slug);
---

<SiteLayout title={brand.name} description={brand.description || `Explore ${brand.name} products.`}>
  <Container>
    <section class="brand-hero" aria-labelledby="page-title">
      <div class="brand-hero-copy">
        <a class="back-link" href="/brands"><span aria-hidden="true">←</span> All brands</a>
        {media && <img class="brand-logo" src={media.logo.src} alt="" />}
        <h1 id="page-title">{brand.name}</h1>
        <p class="brand-lead">{brand.description || `Explore ${brand.name} automotive products.`}</p>
        <a class="text-link" href={`/products?brand=${brand.slug}`}>Browse {brand.name} products <span aria-hidden="true">→</span></a>
      </div>
      {media && (
        <div class="brand-hero-media">
          <img src={media.image.src} alt={media.image.alt} loading="eager" />
        </div>
      )}
    </section>

    {brandCategories.length > 0 && (
      <section class="brand-section" aria-labelledby="categories-title">
        <h2 id="categories-title">Categories</h2>
        <div class="category-grid">
          {brandCategories.map((category) => (
            <CategoryCard
              name={category.name}
              href={`/products?category=${category.slug}`}
              image={getCategoryImage(category.slug)}
            />
          ))}
        </div>
      </section>
    )}

    {brandProducts.length > 0 && (
      <section class="brand-section" aria-labelledby="brand-products-title">
        <h2 id="brand-products-title">{brand.name} products</h2>
        <div class="product-grid">
          {brandProducts.map((product) => (
            <ProductCard
              name={product.name}
              href={`/products/${product.slug}`}
              brand={product.brandName}
              category={product.categoryName}
              specification={product.keySpecification ? `${product.keySpecification.label}: ${product.keySpecification.value}` : null}
              image={product.primaryImage ? { src: product.primaryImage.url, alt: product.primaryImage.altText || product.name } : null}
            />
          ))}
        </div>
      </section>
    )}
  </Container>
</SiteLayout>

<style>
  .brand-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    gap: 3rem clamp(2rem, 5vw, 5rem);
    align-items: center;
    padding-block: clamp(2rem, 5vw, 4rem) clamp(5rem, 9vw, 8rem);
  }

  .brand-hero-copy .back-link {
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .brand-logo {
    display: block;
    height: 28px;
    width: auto;
    margin-bottom: 1.5rem;
    filter: brightness(0) invert(0.92) sepia(0.12);
    opacity: 0.7;
  }

  h1 {
    font-size: clamp(2.5rem, 5vw, 4.25rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .brand-lead {
    margin-block: 1.5rem 1rem;
    max-width: 44ch;
    font-size: 1.0625rem;
    color: var(--color-text-muted);
  }

  .brand-hero-media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 16px;
    background: var(--color-surface);
  }

  .brand-hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .brand-section {
    padding-bottom: clamp(5rem, 9vw, 8rem);
  }

  .brand-section h2 {
    margin-bottom: clamp(2rem, 4vw, 3rem);
    font-size: clamp(2rem, 3.2vw, 3rem);
    letter-spacing: -0.025em;
  }

  .category-grid,
  .product-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 3rem clamp(0.75rem, 1.5vw, 1.25rem);
  }

  .category-grid {
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
  }

  @media (max-width: 64rem) {
    .category-grid,
    .product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 48rem) {
    .brand-hero {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 30rem) {
    .category-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
