---
import type { GetStaticPaths } from 'astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Container from '../../components/Container.astro';
import Button from '../../components/Button.astro';
import { publicCatalogueService } from '@trionyx/api/catalogue';

export const getStaticPaths = (async () => {
  try {
    const { items } = await publicCatalogueService.listPublishedProducts('LAKSHMI');
    return items.map((product) => ({
      params: { slug: product.slug },
      props: { slug: product.slug },
    }));
  } catch (err) {
    console.error('[Product Detail] Failed to get static paths:', err);
    return [];
  }
}) satisfies GetStaticPaths;

const { slug } = Astro.params;
const product = await publicCatalogueService.getPublishedProductBySlug('LAKSHMI', slug as string);

if (!product) {
  return Astro.redirect('/products');
}

const galleryImages = (product.galleryImages && product.galleryImages.length > 0)
  ? product.galleryImages
  : product.primaryImage
    ? [{ id: 'primary', url: product.primaryImage.url, altText: product.primaryImage.altText || product.name, sortOrder: 0 }]
    : [];

const primary = product.primaryImage;
const allImages = primary
  ? [galleryImages.find((image) => image.url === primary.url) || {
      id: 'primary', url: primary.url, altText: primary.altText || product.name, sortOrder: 0,
    }, ...galleryImages.filter((image) => image.url !== primary.url)]
  : galleryImages;
const initialImage = allImages[0] || null;
const hasMultipleImages = allImages.length > 1;
const summary = product.shortDescription?.trim() || product.description?.trim();
const hasMoreDescription = product.description?.trim() && product.description.trim() !== summary;
const supplierLabels = /^(distribution|distributor|supplier)$/i;
const technicalSpecs = product.specifications.filter((spec) => !supplierLabels.test(spec.label.trim()));
const supplierSpecs = product.specifications.filter((spec) => supplierLabels.test(spec.label.trim()));
const enquiryHref = `/contact?${new URLSearchParams({ product: product.name, code: product.productCode }).toString()}`;
---

<SiteLayout
  title={`${product.name} | Lakshmi Distributions`}
  description={product.shortDescription || `Explore ${product.name} distributed by Lakshmi Distributions.`}
>
  <Container>
    <section class="product-detail" aria-labelledby="product-title">
      <a href="/products" class="back-link"><span aria-hidden="true">←</span> All products</a>

      <div class="product-layout">
        <div class="product-gallery" data-product-gallery>
          <div class="product-main-image-box">
            {initialImage ? (
              <img
                id="main-product-image"
                src={initialImage.url}
                alt={initialImage.altText || product.name}
                class="product-main-image"
                loading="eager"
              />
            ) : (
              <span class="product-image-fallback">Contact us for product images.</span>
            )}
          </div>

          {hasMultipleImages && (
            <div class="product-thumbnails" role="region" aria-label="Product images">
              {allImages.map((img, idx) => (
                <button
                  type="button"
                  class={`product-thumb-btn ${idx === 0 ? 'is-active' : ''}`}
                  data-gallery-thumb
                  data-image-src={img.url}
                  data-image-alt={img.altText || `${product.name} view ${idx + 1}`}
                  aria-label={`Show ${img.altText || `${product.name} view ${idx + 1}`}`}
                  aria-pressed={idx === 0 ? 'true' : 'false'}
                >
                  <img src={img.url} alt="" class="product-thumb-image" loading={idx === 0 ? 'eager' : 'lazy'} width="80" height="80" />
                </button>
              ))}
            </div>
          )}
        </div>

        <div class="product-info">
          {(product.brandName || product.categoryName) && (
            <p class="product-meta">
              {product.brandName && <a href={product.brandSlug ? `/brands/${product.brandSlug}` : '/brands'}>{product.brandName}</a>}
              {product.brandName && product.categoryName && <span aria-hidden="true"> · </span>}
              {product.categoryName && <span>{product.categoryName}</span>}
            </p>
          )}
          <h1 id="product-title" class="product-title">{product.name}</h1>
          <p class="product-code">Ref. {product.productCode}</p>

          {summary && <p class="product-lead">{summary}</p>}

          <div class="product-action">
            <Button href={enquiryHref}>Enquire about this product</Button>
            <p class="action-note">Pricing, availability and vehicle compatibility. Your enquiry includes this product’s name and reference.</p>
          </div>

          {technicalSpecs.length > 0 && (
            <div class="specs-section">
              <h2 class="specs-heading">Specifications</h2>
              <dl class="specs-list">
                {technicalSpecs.map((spec) => (
                  <div class="spec-row">
                    <dt>{spec.label}</dt>
                    <dd>{spec.value}</dd>
                  </div>
                ))}
              </dl>
            </div>
          )}

          {hasMoreDescription && (
            <details class="product-description">
              <summary>About this product <span class="faq-icon" aria-hidden="true"></span></summary>
              <p>{product.description}</p>
            </details>
          )}

          {supplierSpecs.length > 0 && (
            <div class="specs-section">
              <h2 class="specs-heading">Supplier</h2>
              <dl class="specs-list">
                {supplierSpecs.map((spec) => (
                  <div class="spec-row">
                    <dt>{spec.label}</dt>
                    <dd>{spec.value}</dd>
                  </div>
                ))}
              </dl>
            </div>
          )}
        </div>
      </div>
    </section>
  </Container>
</SiteLayout>

<style>
  .product-detail {
    padding-block: clamp(1.5rem, 4vw, 3rem) clamp(5rem, 10vw, 9rem);
  }

  .back-link {
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .product-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 3rem clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  /* Gallery */
  .product-gallery {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
  }

  .product-main-image-box {
    display: grid;
    place-items: center;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 16px;
    background: var(--color-surface);
  }

  .product-main-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 200ms ease;
  }

  .product-image-fallback {
    font-size: var(--font-small);
    color: var(--color-text-faint);
  }

  .product-thumbnails {
    display: flex;
    gap: 0.625rem;
    overflow-x: auto;
    padding: 3px;
    scrollbar-width: none;
  }

  .product-thumbnails::-webkit-scrollbar {
    display: none;
  }

  .product-thumb-btn {
    flex: none;
    width: 4.75rem;
    height: 4.75rem;
    padding: 0;
    overflow: hidden;
    background: var(--color-surface);
    border: 0;
    border-radius: 10px;
    cursor: pointer;
    opacity: 0.55;
    transition: opacity 200ms ease, box-shadow 200ms ease;
  }

  .product-thumb-btn:hover {
    opacity: 0.85;
  }

  .product-thumb-btn.is-active {
    opacity: 1;
    box-shadow: 0 0 0 1.5px var(--color-text);
  }

  .product-thumb-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  /* Info */
  .product-info {
    min-width: 0;
  }

  .product-meta {
    font-size: var(--font-small);
    color: var(--color-text-muted);
  }

  .product-meta a {
    color: var(--color-text-muted);
    text-decoration-color: var(--color-hairline);
    text-underline-offset: 0.3rem;
    transition: color 200ms ease;
  }

  .product-meta a:hover {
    color: var(--color-text);
  }

  .product-title {
    margin-top: 1rem;
    font-size: clamp(2.25rem, 4vw, 3.5rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .product-code {
    margin-top: 0.75rem;
    font-size: var(--font-small);
    color: var(--color-text-faint);
  }

  .product-lead {
    margin-top: 1.75rem;
    max-width: 52ch;
    font-size: 1.0625rem;
    color: var(--color-text-muted);
  }

  .product-action {
    margin-top: 2rem;
    padding-bottom: 2.5rem;
  }

  .action-note {
    margin-top: 1rem;
    max-width: 44ch;
    font-size: var(--font-small);
    color: var(--color-text-faint);
  }

  .specs-section {
    padding-block: 2rem;
    border-top: 1px solid var(--color-hairline);
  }

  .specs-heading {
    margin-bottom: 1rem;
    font-size: var(--font-small);
    letter-spacing: 0;
    color: var(--color-text-faint);
  }

  .specs-list {
    margin: 0;
  }

  .spec-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
    padding-block: 0.875rem;
    border-bottom: 1px solid var(--color-hairline);
  }

  .spec-row:last-child {
    border-bottom: 0;
  }

  .spec-row dt {
    color: var(--color-text-muted);
  }

  .spec-row dd {
    margin: 0;
    max-width: 60%;
    text-align: right;
    overflow-wrap: anywhere;
  }

  .product-description {
    border-top: 1px solid var(--color-hairline);
  }

  .product-description summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-block: 1.375rem;
    font-size: 1.0625rem;
    cursor: pointer;
    list-style: none;
  }

  .product-description summary::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    position: relative;
    flex: none;
    width: 12px;
    height: 12px;
  }

  .faq-icon::before,
  .faq-icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 12px;
    height: 1px;
    background: var(--color-text-muted);
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .faq-icon::after {
    transform: rotate(90deg);
  }

  .product-description[open] .faq-icon::after {
    transform: rotate(0deg);
  }

  .product-description p {
    padding-bottom: 1.5rem;
    max-width: 60ch;
    color: var(--color-text-muted);
    white-space: pre-line;
  }

  @media (min-width: 56rem) and (min-height: 46rem) {
    .product-gallery {
      position: sticky;
      top: 6rem;
    }
  }

  @media (max-width: 56rem) {
    .product-layout {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-main-image,
    .product-thumb-btn {
      transition: none;
    }
  }
</style>

<script>
  function setupGallery() {
    const galleryContainers = document.querySelectorAll<HTMLElement>('[data-product-gallery]');

    galleryContainers.forEach((gallery) => {
      if (gallery.dataset.initialized) return;
      gallery.dataset.initialized = 'true';
      const mainImg = gallery.querySelector<HTMLImageElement>('#main-product-image');
      const thumbBtns = gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]');

      if (!mainImg || thumbBtns.length === 0) return;

      thumbBtns.forEach((btn, index) => {
        btn.addEventListener('click', () => {
          const targetSrc = btn.getAttribute('data-image-src');
          const targetAlt = btn.getAttribute('data-image-alt');
          if (!targetSrc) return;

          if (mainImg.getAttribute('src') !== targetSrc) {
            mainImg.src = targetSrc;
            if (targetAlt) {
              mainImg.alt = targetAlt;
            }
          }

          thumbBtns.forEach((b) => {
            b.classList.remove('is-active');
            b.setAttribute('aria-pressed', 'false');
          });

          btn.classList.add('is-active');
          btn.setAttribute('aria-pressed', 'true');
        });

        btn.addEventListener('keydown', (e) => {
          const btnList = Array.from(thumbBtns);
          let targetIndex = -1;

          if (e.key === 'Home' || e.key === 'End') {
            e.preventDefault();
            targetIndex = e.key === 'Home' ? 0 : btnList.length - 1;
          } else if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
            e.preventDefault();
            targetIndex = (index + 1) % btnList.length;
          } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
            e.preventDefault();
            targetIndex = (index - 1 + btnList.length) % btnList.length;
          }

          if (targetIndex >= 0) {
            btnList[targetIndex].focus();
            btnList[targetIndex].click();
          }
        });
      });
    });
  }

  setupGallery();
  document.addEventListener('astro:page-load', setupGallery);
</script>
