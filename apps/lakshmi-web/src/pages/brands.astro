---
import SiteLayout from '../layouts/SiteLayout.astro';
import Container from '../components/Container.astro';
import PageIntro from '../components/PageIntro.astro';
import BrandCard from '../components/BrandCard.astro';
import { publicCatalogueService } from '@trionyx/api/catalogue';
import { getBrandMedia } from '../data/brandMedia';

const brands = await publicCatalogueService.listPublishedBrands('LAKSHMI');
---
<SiteLayout title="Brands" description="Explore brands available through Lakshmi Distributions.">
  <Container>
    <PageIntro
      kicker="Brands"
      title="The manufacturers we work with."
      lead="We partner directly with each brand we carry, so every product comes with authentic inventory and verified specifications."
    />

    <section class="brands" aria-label="Available brands">
      {brands.map((brand) => (
        <BrandCard
          name={brand.name}
          description={brand.description || undefined}
          href={`/brands/${brand.slug}`}
          media={getBrandMedia(brand.slug)}
        />
      ))}
    </section>
  </Container>
</SiteLayout>

<style>
  .brands {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem clamp(1rem, 2vw, 1.5rem);
    padding-bottom: clamp(5rem, 10vw, 9rem);
  }

  @media (max-width: 48rem) {
    .brands {
      grid-template-columns: 1fr;
    }
  }
</style>
