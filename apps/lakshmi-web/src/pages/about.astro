---
import SiteLayout from '../layouts/SiteLayout.astro';
import Container from '../components/Container.astro';
import PageIntro from '../components/PageIntro.astro';
import { getBrandMedia } from '../data/brandMedia';

const brands = [
  {
    slug: 'aozoom',
    name: 'Aozoom',
    description: 'High-performance automotive LED lamps and optical projector modules engineered for clean beam cutoff, high optical clarity, and thermal reliability.',
  },
  {
    slug: 'hogonn',
    name: 'Hogonn',
    description: 'Automotive surface protection films, sun control window films, and Shumoff acoustic damping materials engineered for cabin comfort and vehicle preservation.',
  },
].map((brand) => ({ ...brand, media: getBrandMedia(brand.slug) }));

const principles = [
  {
    title: 'Verified technical specifications',
    body: 'Every product in our catalogue is documented with accurate technical details and real photography — never fabricated metrics or stock claims.',
  },
  {
    title: 'Direct workshop and trade support',
    body: 'Responsive enquiry handling, technical documentation and product guidance for automotive installers and retail partners.',
  },
  {
    title: 'Consistent distribution',
    body: 'From the first product enquiry to order fulfilment, we prioritise dependable availability and straightforward trade communication.',
  },
];
---

<SiteLayout
  title="About Us"
  description="Lakshmi Distributions provides automotive lighting, surface protection films, and acoustic materials to workshops, retailers, and automotive professionals."
>
  <Container>
    <PageIntro
      kicker="About Lakshmi Distributions"
      title="Reliable components. Transparent specifications."
      lead="We distribute automotive lighting, surface protection films and acoustic solutions to retailers, workshops and installers across India. Our catalogue is built around dependable performance, so the people who fit our products can recommend them with confidence."
    />

    <figure class="about-banner">
      <img
        src="/images/hero-built-to-preserve.jpg"
        alt="A classic yellow sports car parked in a sunlit restoration workshop"
        loading="eager"
        fetchpriority="high"
      />
    </figure>

    <section class="about-section" aria-labelledby="brands-title">
      <div class="section-grid">
        <h2 id="brands-title" class="kicker">The brands we carry</h2>
        <div class="brand-rows">
          {brands.map((brand) => (
            <article class="brand-row">
              <div class="brand-row-copy">
                <h3>{brand.name}</h3>
                <p>{brand.description}</p>
                <a class="text-link" href={`/brands/${brand.slug}`}>About {brand.name} <span aria-hidden="true">→</span></a>
              </div>
              {brand.media && (
                <div class="brand-row-media">
                  <img src={brand.media.image.src} alt={brand.media.image.alt} loading="lazy" />
                </div>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="about-section" aria-labelledby="principles-title">
      <div class="section-grid">
        <h2 id="principles-title" class="kicker">What trade partners rely on</h2>
        <div class="principles">
          {principles.map((principle) => (
            <div class="principle">
              <h3>{principle.title}</h3>
              <p>{principle.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </Container>
</SiteLayout>

<style>
  .about-banner {
    margin: 0;
    aspect-ratio: 21 / 9;
    overflow: hidden;
    border-radius: 16px;
    background: var(--color-surface);
  }

  .about-banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 62%;
    filter: brightness(0.82) contrast(1.06);
  }

  .about-section {
    padding-top: clamp(5rem, 10vw, 9rem);
  }

  .about-section:last-child {
    padding-bottom: clamp(5rem, 10vw, 9rem);
  }

  .section-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    gap: 2rem clamp(2rem, 5vw, 5rem);
  }

  .section-grid > h2 {
    margin: 0;
    font-size: var(--font-small);
    letter-spacing: 0;
  }

  .brand-rows {
    border-top: 1px solid var(--color-hairline);
  }

  .brand-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2rem clamp(2rem, 4vw, 4rem);
    align-items: center;
    padding-block: clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--color-hairline);
  }

  .brand-row h3 {
    font-size: clamp(1.75rem, 2.8vw, 2.5rem);
    letter-spacing: -0.025em;
  }

  .brand-row p {
    margin-block: 1rem 0.75rem;
    max-width: 44ch;
    color: var(--color-text-muted);
  }

  .brand-row-media {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: 16px;
    background: var(--color-surface);
  }

  .brand-row-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .principles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem clamp(1.5rem, 3vw, 2.5rem);
  }

  .principle {
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-hairline);
  }

  .principle h3 {
    font-size: 1.25rem;
    line-height: 1.3;
  }

  .principle p {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 64rem) {
    .principles {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 48rem) {
    .about-banner {
      aspect-ratio: 4 / 3;
    }

    .section-grid,
    .brand-row {
      grid-template-columns: 1fr;
    }
  }
</style>
