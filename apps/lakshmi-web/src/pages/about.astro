---
import SiteLayout from '../layouts/SiteLayout.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import EnquiryCTA from '../components/EnquiryCTA.astro';
import Header from '../components/Header.astro';
---

<SiteLayout
  title="About Us"
  description="Lakshmi Distributions provides automotive lighting, surface protection films, and acoustic materials to workshops, retailers, and automotive professionals."
>
  <div slot="header" class="about-overlay-header"><Header dark /></div>

  <section class="about-hero-banner" aria-labelledby="page-title">
    <img
      src="/images/about/carmodify2.png"
      alt="Automotive surface protection film installation and workshop detailing"
      class="about-banner-img"
      width="1920"
      height="1080"
      loading="eager"
      fetchpriority="high"
    />
    <Container>
      <div class="about-hero-stack">
        <h1 id="page-title" class="page-title">About Us</h1>
        <nav class="hero-breadcrumb" aria-label="Breadcrumb">
          <ol><li><a href="/">Home</a></li><li aria-current="page">About Us</li></ol>
        </nav>
      </div>
    </Container>
  </section>

  <Section labelledBy="overview-title" class="about-overview-section">
    <Container>
      <div class="overview-grid">
        <div class="overview-imagery">
          <div class="overview-image-primary-wrap">
            <img
              src="/images/about/about-primary.jpg"
              alt="Automotive LED matrix optical module"
              class="overview-img"
              loading="lazy"
            />
          </div>
          <div class="overview-image-secondary-wrap">
            <img
              src="/images/about/about-secondary.jpg"
              alt="Automotive projector assembly and heatsink component"
              class="overview-img"
              loading="lazy"
            />
          </div>
        </div>
        <div class="overview-content">
          <h2 id="overview-title" class="section-title">Reliable components. Transparent specifications.</h2>
          <p class="body-text">
            We focus on curated automotive product lines with verified technical standards. Our catalogue is built around dependable performance, allowing automotive workshops and retailers to recommend and install solutions with confidence.
          </p>
          <div class="brand-focus-list">
            <div class="brand-focus-item">
              <h3 class="brand-focus-name">Azoom</h3>
              <p class="brand-focus-desc">
                High-performance automotive LED lamps and optical projector modules engineered for clean beam cutoff, high optical clarity, and thermal reliability.
              </p>
            </div>
            <div class="brand-focus-item">
              <h3 class="brand-focus-name">Hoggon</h3>
              <p class="brand-focus-desc">
                Automotive surface protection films, Sun Control Ceramic Window Films, and Shumoff acoustic damping materials engineered for cabin comfort and vehicle preservation.
              </p>
            </div>
          </div>
          <div class="overview-actions">
            <Button href="/products">Browse Catalogue</Button>
            <Button href="/contact" variant="secondary">Contact Distribution</Button>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Section labelledBy="principles-title" class="principles-section">
    <Container>
      <div class="principles-header">
        <p class="eyebrow">DISTRIBUTION STANDARDS</p>
        <h2 id="principles-title" class="section-title">What trade partners rely on</h2>
      </div>
      <div class="principles-grid">
        <div class="principle-card">
          <div class="principle-num">01</div>
          <h3 class="principle-heading">Verified Technical Specifications</h3>
          <p class="principle-body">
            Every product in our catalogue is documented with accurate technical details and real photography—never fabricated metrics or stock claims.
          </p>
        </div>
        <div class="principle-card">
          <div class="principle-num">02</div>
          <h3 class="principle-heading">Direct Workshop & Trade Support</h3>
          <p class="principle-body">
            We provide responsive enquiry handling, technical documentation, and product guidance for automotive installers and retail partners.
          </p>
        </div>
        <div class="principle-card">
          <div class="principle-num">03</div>
          <h3 class="principle-heading">Consistent Distribution</h3>
          <p class="principle-body">
            From initial product enquiries to order fulfilment, we prioritize dependable product availability and straightforward trade communication.
          </p>
        </div>
      </div>
    </Container>
  </Section>

  <EnquiryCTA />
</SiteLayout>

<style>
  .eyebrow {
    font-size: var(--font-label);
    font-weight: var(--weight-strong);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: var(--space-2);
  }

  .about-overlay-header { position: absolute; inset: 0 0 auto; z-index: 5; }
  .about-hero-banner {
    position: relative;
    isolation: isolate;
    height: 400px;
    min-height: 400px;
    max-height: 400px;
    padding-top: clamp(4.5rem, 8vh, 5.5rem);
    padding-bottom: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    background: #0B0D0F;
  }
  .about-banner-img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .about-hero-banner::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(0, 0, 0, 0.65);
  }
  .about-hero-stack { width: 100%; max-width: 56rem; margin-inline: auto; text-align: center; }
  .page-title { margin: 0; font-size: clamp(2.25rem, 3.5vw, 3.25rem); line-height: 1.15; letter-spacing: -.025em; color: #fff; }
  .hero-breadcrumb { margin-top: 1.75rem; padding-top: 1.25rem; border-top: 1px solid rgba(255,255,255,.22); }
  .hero-breadcrumb ol { display: flex; justify-content: center; flex-wrap: wrap; gap: .75rem; list-style: none; margin: 0; padding: 0; font-size: .9375rem; font-weight: 600; }
  .hero-breadcrumb li + li::before { content: '/'; margin-right: .75rem; color: #b7bfc5; }
  .hero-breadcrumb a { color: #c4cbd0; text-decoration: none; }
  .hero-breadcrumb a:hover { color: #fff; text-decoration: underline; }
  .about-overview-section {
    border-top: var(--border-width) solid var(--color-border);
    padding-block: clamp(3.5rem, 6vw, 6rem);
  }

  .overview-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(3rem, 5vw, 5.5rem);
    align-items: center;
  }

  .overview-imagery {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: repeat(12, 1fr);
    aspect-ratio: 4 / 3.2;
    width: 100%;
  }

  .overview-image-primary-wrap {
    grid-column: 1 / 10;
    grid-row: 1 / 11;
    position: relative;
    z-index: 1;
    overflow: hidden;
    border-radius: var(--radius-md);
    border: var(--border-width) solid var(--color-border);
    background: var(--color-surface);
  }

  .overview-image-secondary-wrap {
    grid-column: 7 / 13;
    grid-row: 5 / 13;
    position: relative;
    z-index: 2;
    overflow: hidden;
    border-radius: var(--radius-md);
    border: var(--border-width) solid var(--color-border);
    background: var(--color-surface);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
  }

  .overview-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .overview-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .section-title {
    font-size: clamp(1.625rem, 1.3rem + 1vw, 2.25rem);
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .body-text {
    font-size: var(--font-body);
    line-height: var(--line-body);
    color: var(--color-text-muted);
  }

  .brand-focus-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-block: var(--space-2);
  }

  .brand-focus-item {
    border-left: 2px solid var(--color-primary);
    padding-left: var(--space-4);
  }

  .brand-focus-name {
    font-size: 1.125rem;
    font-weight: var(--weight-strong);
    color: var(--color-text);
    margin-bottom: var(--space-1);
  }

  .brand-focus-desc {
    font-size: var(--font-small);
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .overview-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .principles-section {
    border-top: var(--border-width) solid var(--color-border);
    padding-block: clamp(3.5rem, 6vw, 6rem);
    background: var(--color-surface);
  }

  .principles-header {
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  .principles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }

  .principle-card {
    background: var(--color-background);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .principle-num {
    font-size: var(--font-label);
    font-weight: var(--weight-strong);
    color: var(--color-primary);
    letter-spacing: 0.1em;
  }

  .principle-heading {
    font-size: 1.125rem;
    font-weight: var(--weight-strong);
    color: var(--color-text);
    line-height: 1.3;
  }

  .principle-body {
    font-size: var(--font-small);
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  @media (max-width: 63.999rem) {
    .overview-grid {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }
    .overview-imagery {
      max-width: 32rem;
      margin-inline: auto;
    }
    .principles-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }

  @media (max-width: 47.999rem) {
    .about-hero-banner { height: 280px; min-height: 280px; max-height: 280px; padding-block: 5.5rem 2rem; }
    .hero-breadcrumb { margin-top: 1.5rem; padding-top: 1.25rem; }
    .overview-imagery {
      max-width: 24rem;
    }
    .overview-actions {
      flex-direction: column;
    }
  }
</style>
