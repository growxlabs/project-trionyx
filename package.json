{
  "name": "trionyx-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.6.1",
  "scripts": {
    "test:trix": "pnpm --filter @trionyx/ai test",
    "eval:trix": "pnpm --filter @trionyx/ai exec tsx --test src/__tests__/trix-phase07.test.ts",
    "dev": "turbo dev",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "internal-user:create": "tsx scripts/create-internal-user.ts",
    "db:migrate-to-supabase": "tsx scripts/migrate-sqlite-to-supabase.ts",
    "test": "tsx scripts/test-platform.ts"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "streamdown": "^2.7.0"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "turbo": "^2.4.4",
    "typescript": "^5"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
